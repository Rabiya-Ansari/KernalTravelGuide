@model KernalTravelGuide.Models.Country

@{
    ViewData["Title"] = "Details";
}

<h2>Country Details</h2>

<table class="table">
    <tr>
        <th>Country Name</th>
        <td>@Model.Name</td>
    </tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
