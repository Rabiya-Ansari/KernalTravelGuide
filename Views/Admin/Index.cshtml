@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome back, Admin. Here's what's happening with your travel website.
            </p>
        </div>

        <div>
            <a asp-controller="TourPackages"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Add Tour Package
            </a>
        </div>
    </div>


    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">

        <!-- Users -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Total Users</p>
                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalUsers
                            </h3>
                        </div>

                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people fs-3 text-primary"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-controller="Users"
                           asp-action="Index"
                           class="text-decoration-none small">
                            View Users →
                        </a>
                    </div>
                </div>
            </div>
        </div>


        <!-- Tour Packages -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Tour Packages</p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalPackages
                            </h3>
                        </div>

                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-map fs-3 text-success"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-controller="TourPackages"
                           asp-action="Index"
                           class="text-decoration-none small">
                            View Packages →
                        </a>
                    </div>

                </div>
            </div>
        </div>


        <!-- Bookings -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Total Bookings</p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalBookings
                            </h3>
                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-calendar-check fs-3 text-warning"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-controller="AdminBookings"
                           asp-action="Index"
                           class="text-decoration-none small">
                            Manage Bookings →
                        </a>
                    </div>

                </div>
            </div>
        </div>


        <!-- Tourist Spots -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">Tourist Spots</p>

                            <h3 class="fw-bold mb-0">
                                @ViewBag.TotalTouristSpots
                            </h3>
                        </div>

                        <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-geo-alt fs-3 text-danger"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-controller="TouristSpots"
                           asp-action="Index"
                           class="text-decoration-none small">
                            View Tourist Spots →
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Second Statistics Row -->
    <div class="row g-4 mb-4">

        <!-- Hotels -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-info bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-building fs-4 text-info"></i>
                        </div>

                        <div>
                            <p class="text-muted mb-1">Hotels</p>
                            <h4 class="fw-bold mb-0">
                                @ViewBag.TotalHotels
                            </h4>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Restaurants -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-warning bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-cup-hot fs-4 text-warning"></i>
                        </div>

                        <div>
                            <p class="text-muted mb-1">Restaurants</p>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.TotalRestaurants
                            </h4>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Resorts -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-house-heart fs-4 text-success"></i>
                        </div>

                        <div>
                            <p class="text-muted mb-1">Resorts</p>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.TotalResorts
                            </h4>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- Feedback -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-star fs-4 text-primary"></i>
                        </div>

                        <div>
                            <p class="text-muted mb-1">Feedbacks</p>

                            <h4 class="fw-bold mb-0">
                                @ViewBag.TotalFeedbacks
                            </h4>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Recent Bookings + Quick Actions -->
    <div class="row g-4 mb-4">

        <!-- Recent Bookings -->
        <div class="col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Recent Bookings
                            </h5>

                            <p class="text-muted small mb-0">
                                Latest tour package bookings
                            </p>
                        </div>

                        <a asp-controller="Bookings"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">
                            View All
                        </a>

                    </div>

                </div>


                <div class="card-body px-4">

                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>
                                <tr>
                                    <th>Package</th>
                                    <th>Travel Date</th>
                                    <th>Persons</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (ViewBag.RecentBookings != null &&
                                ViewBag.RecentBookings.Count > 0)
                                {
                                    foreach (var booking in ViewBag.RecentBookings)
                                    {
                                        <tr>

                                            <td>
                                                @if (booking.TourPackage != null)
                                                {
                                                    <span>@booking.TourPackage.PackageName</span>
                                                }
                                                else if (booking.Hotel != null)
                                                {
                                                    <span>@booking.Hotel?.Name (Hotel)</span>
                                                }
                                                else if (booking.Resort != null)
                                                {
                                                    <span>@booking.Resort.ResortName (Resort)</span>
                                                }
                                                else
                                                {
                                                    <span>N/A</span>
                                                }
                                            </td>

                                            <td>
                                                @booking.TravelDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                @booking.NumberOfPersons
                                            </td>

                                            <td>
                                                <strong>
                                                    Rs. @booking.TotalAmount.ToString("N0")
                                                </strong>
                                            </td>

                                            <td>

                                                @if (booking.Status.ToString() == "Confirmed")
                                                {
                                                    <span class="badge bg-success">
                                                        Confirmed
                                                    </span>
                                                }
                                                else if (booking.Status.ToString() == "Cancelled")
                                                {
                                                    <span class="badge bg-danger">
                                                        Cancelled
                                                    </span>
                                                }
                                                else if (booking.Status.ToString() == "Completed")
                                                {
                                                    <span class="badge bg-primary">
                                                        Completed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        Pending
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">
                                            No bookings found.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-xl-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-1">
                        Quick Actions
                    </h5>

                    <p class="text-muted small">
                        Manage your website
                    </p>
                </div>

                <div class="card-body px-4">

                    <div class="d-grid gap-3">

                        <a asp-controller="TourPackages"
                           asp-action="Create"
                           class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Add Tour Package
                        </a>

                        <a asp-controller="TouristSpots"
                           asp-action="Create"
                           class="btn btn-outline-primary">
                            <i class="bi bi-geo-alt me-2"></i>
                            Add Tourist Spot
                        </a>

                        <a asp-controller="Hotels"
                           asp-action="Create"
                           class="btn btn-outline-success">
                            <i class="bi bi-building me-2"></i>
                            Add Hotel
                        </a>

                        <a asp-controller="Restaurants"
                           asp-action="Create"
                           class="btn btn-outline-warning">
                            <i class="bi bi-cup-hot me-2"></i>
                            Add Restaurant
                        </a>

                        <a asp-controller="Gallery"
                           asp-action="Create"
                           class="btn btn-outline-info">
                            <i class="bi bi-images me-2"></i>
                            Add Gallery Image
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Recent Feedback -->
    <div class="row">

        <div class="col-12">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h5 class="fw-bold mb-1">
                                Recent Feedback
                            </h5>

                            <p class="text-muted small mb-0">
                                Latest customer feedback
                            </p>
                        </div>

                        <a asp-controller="Feedbacks"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">
                            View All
                        </a>

                    </div>

                </div>


                <div class="card-body px-4">

                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Email</th>
                                    <th>Rating</th>
                                    <th>Comments</th>
                                    <th>Date</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (ViewBag.RecentFeedbacks != null &&
                                ViewBag.RecentFeedbacks.Count > 0)
                                {
                                    foreach (var feedback in ViewBag.RecentFeedbacks)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @feedback.CustomerName
                                                </strong>
                                            </td>

                                            <td>
                                                @feedback.Email
                                            </td>

                                            <td>
                                                <span class="text-warning">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= feedback.Rating)
                                                        {
                                                            <i class="bi bi-star-fill"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-star"></i>
                                                        }
                                                    }
                                                </span>
                                            </td>

                                            <td>
                                                @(feedback.Comments?.Length > 60
                                                    ? feedback.Comments.Substring(0, 60) + "..."
                                                    : feedback.Comments)
                                            </td>

                                            <td>
                                                @feedback.FeedbackDate.ToString("dd MMM yyyy")
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">
                                            No feedback found.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>