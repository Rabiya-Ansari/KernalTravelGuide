@model KernalTravelGuide.Models.TravelInformation

@{
    ViewData["Title"] = "Travel Information Details";
}

<h1>Travel Information Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Transport
    </dt>

    <dd class="col-sm-9">
        @Model.TransportName
    </dd>


    <dt class="col-sm-3">
        From City
    </dt>

    <dd class="col-sm-9">
        @Model.FromCity?.Name
    </dd>


    <dt class="col-sm-3">
        To City
    </dt>

    <dd class="col-sm-9">
        @Model.ToCity?.Name
    </dd>


    <dt class="col-sm-3">
        Fare
    </dt>

    <dd class="col-sm-9">
        @Model.Fare
    </dd>


    <dt class="col-sm-3">
        Description
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>