@model KernalTravelGuide.Models.TravelInformation

@{
    ViewData["Title"] = "Delete Travel Information";
}

<h1>Delete Travel Information</h1>

<h3>Are you sure you want to delete this?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Transport
    </dt>

    <dd class="col-sm-9">
        @Model.TransportName
    </dd>


    <dt class="col-sm-3">
        From City
    </dt>

    <dd class="col-sm-9">
        @Model.FromCity?.Name
    </dd>


    <dt class="col-sm-3">
        To City
    </dt>

    <dd class="col-sm-9">
        @Model.ToCity?.Name
    </dd>


    <dt class="col-sm-3">
        Fare
    </dt>

    <dd class="col-sm-9">
        @Model.Fare
    </dd>


    <dt class="col-sm-3">
        Description
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>