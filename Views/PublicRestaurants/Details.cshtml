@model KernalTravelGuide.Models.Restaurant

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = Model.Name + " - Details & Booking";
}

<div class="untree_co-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="card shadow-sm border-0 p-4">

                    <!-- Restaurant Image -->
                    <div class="mb-4 text-center">
                        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                        {
                            <img src="@Url.Content(Model.ImagePath)" alt="@Model.Name" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/client/assets/images/hero-slider-1.jpg" alt="@Model.Name" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;" />
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="text-primary mb-0">@Model.Name</h2>
                        <span class="badge badge-warning p-2 h5 mb-0">★ @Model.Rating Rating</span>
                    </div>

                    <p class="text-muted mb-4">
                        <i class="icon-room text-primary"></i> @(Model.City?.Name ?? "Pakistan")
                    </p>

                    <hr />

                    <!-- Contact Details -->
                    <div class="bg-light p-3 rounded mb-4">
                        <h5 class="font-weight-bold mb-3">Restaurant Information</h5>
                        <ul class="list-unstyled mb-0">
                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <li class="mb-2"><strong>Phone / Contact:</strong> @Model.Phone</li>
                            }
                        </ul>
                    </div>

                    <!-- Actions (Resort Style Buttons) -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            Back to Restaurants List
                        </a>

                        <div class="d-flex gap-2">
                            @if (User.IsInRole("Customer"))
                            {
                                <a asp-controller="Feedback"
                                   asp-action="Create"
                                   asp-route-restaurantId="@Model.Id"
                                   class="btn btn-outline-primary me-2">
                                    <i class="fa fa-star"></i> Give Your Review
                                </a>
                            }

                            <a asp-controller="PublicRestaurants"
                               asp-action="BookNow"
                               asp-route-restaurantId="@Model.Id"
                               class="btn btn-primary btn-lg">
                                Book Table Now
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>