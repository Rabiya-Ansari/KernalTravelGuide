@model IEnumerable<KernalTravelGuide.Models.Restaurant>

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Featured Restaurants";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Featured Restaurants</h1>
                    <p class="text-white">
                        Discover delicious dining options at popular destinations.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="untree_co-section bg-light">
    <div class="container">

        <!-- Section heading -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-6">
                <h2 class="section-title text-center mb-3">
                    Featured Restaurants
                </h2>
                <p class="text-muted">
                    Discover restaurants and dining places available at popular destinations.
                </p>
            </div>
        </div>

        <!-- Restaurant cards -->
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var restaurant in Model)
                {
                    <div class="col-6 col-md-6 col-lg-3 mb-4">
                        <div class="media-1 h-100 shadow-sm rounded p-3 bg-white d-flex flex-column">

                            <!-- Restaurant image -->
                            <a asp-controller="PublicRestaurants"
                               asp-action="Details"
                               asp-route-id="@restaurant.Id"
                               class="d-block mb-3">
                                @if (!string.IsNullOrWhiteSpace(restaurant.ImagePath))
                                {
                                    <img src="@Url.Content(restaurant.ImagePath)"
                                         alt="@restaurant.Name"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/client/assets/images/hero-slider-1.jpg"
                                         alt="@restaurant.Name"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                            </a>

                            <!-- Restaurant information -->
                            <div class="d-flex flex-column flex-grow-1">
                                <h3 class="h5">
                                    <a asp-controller="PublicRestaurants"
                                       asp-action="Details"
                                       asp-route-id="@restaurant.Id" class="text-dark">
                                        @restaurant.Name
                                    </a>
                                </h3>

                                <!-- Restaurant location -->
                                <span class="d-flex align-items-center loc mb-2 text-muted small">
                                    <span class="icon-room mr-1 text-primary"></span>
                                    <span>
                                        @(restaurant.City?.Name ?? "Pakistan")
                                    </span>
                                </span>

                                <!-- Rating -->
                                <div class="mb-3">
                                    <span class="badge badge-warning">★ @restaurant.Rating</span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="mt-auto">
                                    <a asp-controller="PublicRestaurants"
                                       asp-action="Details"
                                       asp-route-id="@restaurant.Id"
                                       class="btn btn-outline-primary btn-sm btn-block mb-2">
                                        View Details
                                    </a>
                                    <a asp-controller="PublicRestaurants"
                                       asp-action="Details"
                                       asp-route-id="@restaurant.Id"
                                       class="btn btn-primary btn-sm btn-block">
                                        Book Table Now
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty state -->
                <div class="col-12 text-center py-5">
                    <i class="icon-utensils display-4 text-muted"></i>
                    <h4 class="mt-3">No restaurants available</h4>
                    <p class="text-muted">Restaurants will appear here when they are added.</p>
                </div>
            }
        </div>

    </div>
</div>