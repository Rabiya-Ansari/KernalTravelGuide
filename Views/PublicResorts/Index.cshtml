@model IEnumerable<KernalTravelGuide.Models.Resort>

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Featured Resorts";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Featured Resorts</h1>
                    <p class="text-white">
                        Find relaxing and beautiful resorts for your next vacation.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="untree_co-section">
    <div class="container">

        <!-- Section heading -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-6">
                <h2 class="section-title text-center mb-3">
                    Featured Resorts
                </h2>
                <p class="text-muted">
                    Relax, unwind and discover beautiful resorts available at your favorite destinations.
                </p>
            </div>
        </div>

        <!-- Resort cards -->
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var resort in Model)
                {
                    <div class="col-6 col-md-6 col-lg-3 mb-4">
                        <div class="media-1 h-100 shadow-sm rounded p-3 bg-white d-flex flex-column">

                            <!-- Resort image -->
                            <a asp-controller="PublicResorts"
                               asp-action="Details"
                               asp-route-id="@resort.Id"
                               class="d-block mb-3">
                                @if (!string.IsNullOrWhiteSpace(resort.ImagePath))
                                {
                                    <img src="@Url.Content(resort.ImagePath)"
                                         alt="@resort.Name"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/client/assets/images/hero-slider-1.jpg"
                                         alt="@resort.Name"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                            </a>

                            <!-- Resort information -->
                            <div class="d-flex flex-column flex-grow-1">
                                <h3 class="h5">
                                    <a asp-controller="PublicResorts"
                                       asp-action="Details"
                                       asp-route-id="@resort.Id" class="text-dark">
                                        @resort.Name
                                    </a>
                                </h3>

                                <!-- Resort location -->
                                <span class="d-flex align-items-center loc mb-3 text-muted small">
                                    <span class="icon-room mr-1 text-primary"></span>
                                    <span>
                                        @(resort.City?.Name ?? "Pakistan")
                                    </span>
                                </span>

                                <!-- Action button -->
                                <div class="mt-auto">
                                    <a asp-controller="PublicResorts"
                                       asp-action="Details"
                                       asp-route-id="@resort.Id"
                                       class="btn btn-primary btn-sm btn-block">
                                        View Resort
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty state -->
                <div class="col-12 text-center py-5">
                    <i class="icon-tree display-4 text-muted"></i>
                    <h4 class="mt-3">No resorts available</h4>
                    <p class="text-muted">
                        Resorts will appear here when they are added.
                    </p>
                </div>
            }
        </div>

    </div>
</div>