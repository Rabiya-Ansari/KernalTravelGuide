@model IEnumerable<KernalTravelGuide.Models.Hotel>

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Featured Hotels";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Featured Hotels</h1>
                    <p class="text-white">
                        Find comfortable and convenient places to stay during your journey.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="untree_co-section">
    <div class="container">

        <!-- Section heading -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-6">
                <h2 class="section-title text-center mb-3">
                    Featured Hotels
                </h2>
                <p class="text-muted">
                    Find comfortable and convenient places to stay during your journey.
                </p>
            </div>
        </div>

        <!-- Hotel cards -->
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var hotel in Model)
                {
                    <div class="col-6 col-md-6 col-lg-3 mb-4">
                        <div class="media-1 h-100 shadow-sm rounded p-3 bg-white">

                            <!-- Hotel image -->
                            <a asp-controller="PublicHotels"
                               asp-action="Details"
                               asp-route-id="@hotel.Id"
                               class="d-block mb-3">
                                @if (!string.IsNullOrWhiteSpace(hotel.ImagePath))
                                {
                                    <img src="@Url.Content(hotel.ImagePath)"
                                         alt="@hotel.Name"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/client/assets/images/hero-slider-1.jpg"
                                         alt="@hotel.Name"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                            </a>

                            <!-- Hotel information -->
                            <div>
                                <h3 class="h5">
                                    <a asp-controller="PublicHotels"
                                       asp-action="Details"
                                       asp-route-id="@hotel.Id" class="text-dark">
                                        @hotel.Name
                                    </a>
                                </h3>

                                <!-- Hotel location -->
                                <span class="d-flex align-items-center loc mb-2 text-muted small">
                                    <span class="icon-room mr-1 text-primary"></span>
                                    <span>
                                        @(hotel.City?.Name ?? "Pakistan")
                                    </span>
                                </span>

                                <!-- Price & Rating -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-success font-weight-bold">PKR @hotel.PricePerNight / night</span>
                                    @if (hotel.StarRating > 0)
                                    {
                                        <span class="badge badge-warning">★ @hotel.StarRating</span>
                                    }
                                </div>

                                <!-- View hotel button -->
                                <a asp-controller="PublicHotels"
                                   asp-action="Details"
                                   asp-route-id="@hotel.Id"
                                   class="btn btn-primary btn-sm btn-block mt-2">
                                    View Hotel
                                </a>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty state -->
                <div class="col-12 text-center py-5">
                    <i class="icon-building display-4 text-muted"></i>
                    <h4 class="mt-3">No hotels available</h4>
                    <p class="text-muted">Hotels will appear here when they are added.</p>
                </div>
            }
        </div>

    </div>
</div>