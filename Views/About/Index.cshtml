@{
    ViewData["Title"] = "About Us";
}

<!-- About Us Hero Section -->
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-3">About Karnel Travel Guide</h1>
                    <p class="text-white">
                        Your trusted travel guide for discovering tourist destinations,
                        accommodation, transportation and tour packages.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Company Introduction -->
<div class="untree_co-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="~/client/assets/images/hero-slider-2.jpg"
                     alt="Karnel Travel Guide"
                     class="img-fluid rounded-20">
            </div>

            <div class="col-lg-6">
                <h2 class="section-title mb-4">Welcome to Karnel Travel Guide</h2>

                <p>
                    Karnel Travel Guide is a tourism and travel information platform
                    designed to help customers explore tourist destinations,
                    transportation facilities, hotels, restaurants, resorts and
                    tour packages available across the country.
                </p>

                <p>
                    Our website provides useful travel information in one place,
                    allowing customers to search destinations and facilities,
                    explore available tour packages and make online bookings.
                </p>

                <p>
                    We aim to make travel planning simple, convenient and accessible
                    by providing organized information about destinations,
                    accommodation and transportation services.
                </p>
            </div>

        </div>
    </div>
</div>

<!-- Services -->
<div class="untree_co-section">
    <div class="container">

        <div class="row justify-content-center mb-5">
            <div class="col-lg-7 text-center">
                <h2 class="section-title">Our Facilities</h2>
                <p>
                    Karnel Travel Guide provides a range of services to help
                    customers plan and enjoy their journeys.
                </p>
            </div>
        </div>

        <div class="row">

            <!-- Tourist Spots -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h4>Tourist Spots</h4>
                    <p>
                        Explore information about tourist destinations,
                        attractions, locations and entry fees.
                    </p>
                    <a asp-controller="PublicTouristSpots"
                       asp-action="Index"
                       class="btn btn-primary">
                        Explore Tourist Spots
                    </a>
                </div>
            </div>

            <!-- Transportation -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h4>Transportation</h4>
                    <p>
                        View available transportation facilities,
                        routes between cities and transportation fares.
                    </p>
                    <a asp-controller="PublicTravelInformation"
                       asp-action="Index"
                       class="btn btn-primary">
                        Travel Information
                    </a>
                </div>
            </div>

            <!-- Hotels -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h4>Hotels</h4>
                    <p>
                        Find hotels according to location, price,
                        quality and availability.
                    </p>
                    <a asp-controller="PublicHotels"
                       asp-action="Index"
                       class="btn btn-primary">
                        Explore Hotels
                    </a>
                </div>
            </div>

            <!-- Restaurants -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h4>Restaurants</h4>
                    <p>
                        Discover restaurants available at different
                        tourist locations.
                    </p>
                    <a asp-controller="PublicRestaurants"
                       asp-action="Index"
                       class="btn btn-primary">
                        Explore Restaurants
                    </a>
                </div>
            </div>

            <!-- Resorts -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h4>Resorts</h4>
                    <p>
                        Explore resorts based on location, price,
                        rating and availability.
                    </p>
                    <a asp-controller="PublicResorts"
                       asp-action="Index"
                       class="btn btn-primary">
                        Explore Resorts
                    </a>
                </div>
            </div>

            <!-- Tour Packages -->
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h4>Tour Packages</h4>
                    <p>
                        Explore available tour packages and book
                        your preferred travel package online.
                    </p>
                    <a asp-controller="PublicTourPackages"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Packages
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Why Choose Us -->
<div class="untree_co-section bg-light">
    <div class="container">

        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">

                <h2 class="section-title mb-4">
                    Why Choose Karnel Travel Guide?
                </h2>

                <p>
                    Our platform brings important travel information together
                    so customers can easily discover destinations, compare
                    available facilities and plan their trips.
                </p>

                <ul class="list-unstyled">
                    <li class="mb-2">✓ Tourist destination information</li>
                    <li class="mb-2">✓ Transportation information</li>
                    <li class="mb-2">✓ Hotel and accommodation information</li>
                    <li class="mb-2">✓ Restaurant information</li>
                    <li class="mb-2">✓ Resort information</li>
                    <li class="mb-2">✓ Tour packages and online booking</li>
                    <li class="mb-2">✓ Search and advanced search facilities</li>
                    <li class="mb-2">✓ Customer feedback and reviews</li>
                </ul>

            </div>
        </div>

    </div>
</div>

<!-- Contact CTA -->
<div class="py-5 cta-section">
    <div class="container">
        <div class="row text-center">

            <div class="col-md-12">

                <h2 class="mb-3 text-white">
                    Plan Your Journey With Us
                </h2>

                <p class="mb-4 lead text-white">
                    Explore destinations, accommodation, transportation
                    and tour packages with Karnel Travel Guide.
                </p>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="btn btn-outline-white text-white">
                    Contact Us
                </a>

            </div>

        </div>
    </div>
</div>