@model KernalTravelGuide.Models.Review

@{
    ViewData["Title"] = "Review Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Review Details</h1>

        <p class="text-muted mb-0">
            View customer review
        </p>
    </div>

    <div>

        <a asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger">

            <i class="bi bi-trash"></i>
            Delete

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>

</div>


<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <h5 class="mb-0">
            Review #@Model.Id
        </h5>

    </div>


    <div class="card-body">

        <div class="row g-4">


            <!-- User -->

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-person"></i>
                        Customer
                    </h6>

                    @if (Model.User != null)
                    {
                        <p class="mb-2">

                            <strong>Name:</strong>

                            @Model.User.FirstName
                            @Model.User.LastName

                        </p>

                        <p class="mb-0">

                            <strong>Email:</strong>

                            @Model.User.Email

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            User information unavailable.
                        </p>
                    }

                </div>

            </div>


            <!-- Rating -->

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-star"></i>
                        Rating
                    </h6>

                    <div class="fs-4 text-warning">

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.Rating)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }

                    </div>

                    <small class="text-muted">
                        @Model.Rating out of 5
                    </small>

                </div>

            </div>


            <!-- Place -->

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-geo-alt"></i>
                        Reviewed Place
                    </h6>

                    @if (Model.TouristSpot != null)
                    {
                        <p class="mb-0">
                            <strong>Tourist Spot:</strong>
                            @Model.TouristSpot.Name
                        </p>
                    }
                    else if (Model.Hotel != null)
                    {
                        <p class="mb-0">
                            <strong>Hotel:</strong>
                            @Model.Hotel.Name
                        </p>
                    }
                    else if (Model.Restaurant != null)
                    {
                        <p class="mb-0">
                            <strong>Restaurant:</strong>
                            @Model.Restaurant.Name
                        </p>
                    }
                    else if (Model.Resort != null)
                    {
                        <p class="mb-0">
                            <strong>Resort:</strong>
                            @Model.Resort.Name
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No place selected.
                        </p>
                    }

                </div>

            </div>


            <!-- Date -->

            <div class="col-md-6">

                <div class="border rounded p-3 h-100">

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-calendar"></i>
                        Review Date
                    </h6>

                    <p class="mb-0">
                        @Model.ReviewDate.ToString("dd MMMM yyyy hh:mm tt")
                    </p>

                </div>

            </div>


            <!-- Comment -->

            <div class="col-12">

                <div class="border rounded p-3">

                    <h6 class="text-muted mb-3">
                        <i class="bi bi-chat-square-text"></i>
                        Customer Comment
                    </h6>

                    <p class="mb-0">
                        @Model.Comment
                    </p>

                </div>

            </div>


        </div>

    </div>

</div>