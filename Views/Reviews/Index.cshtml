@model IEnumerable<KernalTravelGuide.Models.Review>

@{
    ViewData["Title"] = "Reviews";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Header section for the Reviews management page. -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>
        <h1 class="mb-1">
            Reviews
        </h1>

        <p class="text-muted mb-0">
            Manage customer reviews and ratings.
        </p>
    </div>

    <!-- Display the total number of reviews. -->
    <span class="badge rounded-pill text-bg-light border px-3 py-2">
        <i class="bi bi-star me-1"></i>
        @Model.Count() Reviews
    </span>

</div>


<!-- Display the success message after a review is deleted. -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- Main Reviews card. -->
<div class="card shadow-sm border-0">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">
                    Customer Reviews
                </h5>

                <small class="text-muted">
                    View ratings and feedback submitted by customers.
                </small>
            </div>

            <i class="bi bi-chat-square-text fs-4 text-primary"></i>

        </div>

    </div>


    <div class="card-body px-4 pb-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Place</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>


                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Review ID. -->
                                <td>
                                    <strong>
                                        #@item.Id
                                    </strong>
                                </td>


                                <!-- Customer information. -->
                                <td>

                                    @if (item.User != null)
                                    {
                                        <div class="fw-semibold">
                                            @item.User.FirstName
                                            @item.User.LastName
                                        </div>

                                        <small class="text-muted">
                                            @item.User.Email
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unknown User
                                        </span>
                                    }

                                </td>


                                <!-- Identify which entity was reviewed. -->
                                <td>

                                    @if (item.TouristSpot != null)
                                    {
                                        <span>
                                            <i class="bi bi-geo-alt me-1"></i>
                                            @item.TouristSpot.Name
                                        </span>
                                    }
                                    else if (item.Hotel != null)
                                    {
                                        <span>
                                            <i class="bi bi-building me-1"></i>
                                            @item.Hotel.Name
                                        </span>
                                    }
                                    else if (item.Restaurant != null)
                                    {
                                        <span>
                                            <i class="bi bi-cup-hot me-1"></i>
                                            @item.Restaurant.Name
                                        </span>
                                    }
                                    else if (item.Resort != null)
                                    {
                                        <span>
                                            <i class="bi bi-house-heart me-1"></i>
                                            @item.Resort.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No place
                                        </span>
                                    }

                                </td>


                                <!-- Display the rating as five stars. -->
                                <td>

                                    <span class="text-warning">

                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }

                                    </span>

                                    <small class="text-muted">
                                        (@item.Rating/5)
                                    </small>

                                </td>


                                <!-- Show a shortened version of the comment. -->
                                <td>

                                    @{
                                        var comment = item.Comment ?? "";

                                        if (comment.Length > 60)
                                        {
                                            comment = comment.Substring(0, 60) + "...";
                                        }
                                    }

                                    @comment

                                </td>


                                <!-- Review date. -->
                                <td>
                                    @item.ReviewDate.ToString("dd MMM yyyy")
                                </td>


                                <!-- Review management actions. -->
                                <td class="text-end">

                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete Review">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty-state message when there are no reviews. -->
                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <i class="bi bi-chat-square-text fs-1 text-muted"></i>

                                <h5 class="mt-3">
                                    No reviews found
                                </h5>

                                <p class="text-muted mb-0">
                                    Customer reviews will appear here.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>