@model KernalTravelGuide.Models.TouristSpot

@{
    ViewData["Title"] = "Create Tourist Spot";
}

<h2>Create Tourist Spot</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Name -->
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>

                <input asp-for="Name" class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <!-- City Dropdown -->
            <div class="form-group mb-3">
                <label asp-for="CityId" class="control-label">
                    City
                </label>

                <select asp-for="CityId"
                        class="form-control"
                        asp-items="ViewBag.CityId">

                    <option value="">
                        -- Select City --
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger"></span>
            </div>

            <!-- Entry Fee -->
            <div class="form-group mb-3">
                <label asp-for="EntryFee" class="control-label"></label>

                <input asp-for="EntryFee"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="EntryFee"
                      class="text-danger"></span>
            </div>

            <!-- Map URL -->
            <div class="form-group mb-3">
                <label asp-for="MapUrl" class="control-label"></label>

                <input asp-for="MapUrl"
                       class="form-control"
                       placeholder="https://maps.google.com/..." />

                <span asp-validation-for="MapUrl"
                      class="text-danger"></span>
            </div>

            <!-- Image Path -->
            <div class="form-group mb-3">
                <label asp-for="ImagePath" class="control-label"></label>

                <input asp-for="ImagePath"
                       class="form-control"
                       placeholder="images/spot.jpg" />

                <span asp-validation-for="ImagePath"
                      class="text-danger"></span>
            </div>

            <!-- Is Active -->
            <div class="form-check mb-3">
                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}