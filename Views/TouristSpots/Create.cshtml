@model KernalTravelGuide.Models.TouristSpot

@{
    ViewData["Title"] = "Create Tourist Spot";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Create Tourist Spot</h1>

<div class="row">
    <div class="col-md-7">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name"
                       class="control-label">
                    Spot Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"
                       class="control-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CityId"
                       class="control-label">
                    City
                </label>

                <select asp-for="CityId"
                        class="form-control"
                        asp-items="ViewBag.CityId">

                    <option value="">
                        -- Select City --
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EntryFee"
                       class="control-label">
                    Entry Fee
                </label>

                <input asp-for="EntryFee"
                       class="form-control"
                       type="number"
                       min="0"
                       max="50000"
                       step="0.01" />

                <span asp-validation-for="EntryFee"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MapUrl"
                       class="control-label">
                    Google Maps URL
                </label>

                <input asp-for="MapUrl"
                       class="form-control"
                       placeholder="https://maps.google.com/..." />

                <span asp-validation-for="MapUrl"
                      class="text-danger"></span>
            </div>

            <!-- ACTUAL IMAGE -->
            <div class="form-group mb-3">

                <label class="form-label">
                    Tourist Spot Image
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

                <small class="text-muted">
                    Choose an image from your computer.
                </small>

            </div>

            <div class="form-check mb-3">

                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                    Active
                </label>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create Tourist Spot
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}