@model KernalTravelGuide.Models.TouristSpot

@{
    ViewData["Title"] = "Edit Tourist Spot";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Edit Tourist Spot</h1>

<div class="row">
    <div class="col-md-7">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name">
                    Spot Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CityId">
                    City
                </label>

                <select asp-for="CityId"
                        class="form-control"
                        asp-items="ViewBag.CityId">

                    <option value="">
                        -- Select City --
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EntryFee">
                    Entry Fee
                </label>

                <input asp-for="EntryFee"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="EntryFee"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MapUrl">
                    Google Maps URL
                </label>

                <input asp-for="MapUrl"
                       class="form-control" />

                <span asp-validation-for="MapUrl"
                      class="text-danger"></span>
            </div>

            <!-- CURRENT IMAGE -->
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-3">

                    <label class="form-label">
                        Current Image
                    </label>

                    <br />

                    <img src="@Model.ImagePath"
                         alt="@Model.Name"
                         style="width:220px;height:140px;object-fit:cover;border-radius:8px;" />

                </div>
            }

            <!-- NEW IMAGE -->
            <div class="form-group mb-3">

                <label class="form-label">
                    Change Image
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

                <small class="text-muted">
                    Leave empty to keep the current image.
                </small>

            </div>

            <div class="form-check mb-3">

                <input asp-for="IsActive"
                       class="form-check-input" />

                <label asp-for="IsActive"
                       class="form-check-label">
                    Active
                </label>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}