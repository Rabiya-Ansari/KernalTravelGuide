@model KernalTravelGuide.Models.TouristSpot

@{
    ViewData["Title"] = "Tourist Spot Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Tourist Spot Details</h1>

<div class="row">

    <div class="col-md-5">

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath"
                 alt="@Model.Name"
                 style="width:100%;max-width:400px;height:260px;object-fit:cover;border-radius:10px;" />
        }
        else
        {
            <p>No image available.</p>
        }

    </div>

    <div class="col-md-7">

        <dl class="row">

            <dt class="col-sm-4">
                Name
            </dt>

            <dd class="col-sm-8">
                @Model.Name
            </dd>

            <dt class="col-sm-4">
                Description
            </dt>

            <dd class="col-sm-8">
                @Model.Description
            </dd>

            <dt class="col-sm-4">
                City
            </dt>

            <dd class="col-sm-8">
                @Model.City?.Name
            </dd>

            <dt class="col-sm-4">
                Entry Fee
            </dt>

            <dd class="col-sm-8">
                @Model.EntryFee
            </dd>

            <dt class="col-sm-4">
                Map
            </dt>

            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.MapUrl))
                {
                    <a href="@Model.MapUrl"
                       target="_blank">
                        Open Google Maps
                    </a>
                }
            </dd>

            <dt class="col-sm-4">
                Status
            </dt>

            <dd class="col-sm-8">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Inactive
                    </span>
                }
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>