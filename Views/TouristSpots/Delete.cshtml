@model KernalTravelGuide.Models.TouristSpot

@{
    ViewData["Title"] = "Delete";
}

<h2>Delete Tourist Spot</h2>

<h4>Are you sure you want to delete this tourist spot?</h4>

<table class="table table-bordered">

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>

    <tr>
        <th>City</th>
        <td>@Model.City?.Name</td>
    </tr>

    <tr>
        <th>Entry Fee</th>
        <td>@Model.EntryFee</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-danger">Inactive</span>
            }
        </td>
    </tr>

</table>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>