@model IEnumerable<KernalTravelGuide.Models.Feedback>

@{
    ViewData["Title"] = "Feedback";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Customer Feedback</h1>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Email</th>
            <th>Rating</th>
            <th>Comments</th>
            <th>Feedback Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.CustomerName
                </td>

                <td>
                    @item.Email
                </td>

                <td>
                    @item.Rating / 5
                </td>

                <td>
                    @item.Comments
                </td>

                <td>
                    @item.FeedbackDate.ToString("dd MMM yyyy hh:mm tt")
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        View
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>