@model KernalTravelGuide.Models.Feedback

@{
    ViewData["Title"] = "Feedback Details";
}

<h1>Feedback Details</h1>

<div class="card">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Customer Name
            </dt>

            <dd class="col-sm-9">
                @Model.CustomerName
            </dd>


            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>


            <dt class="col-sm-3">
                Rating
            </dt>

            <dd class="col-sm-9">
                @Model.Rating / 5
            </dd>


            <dt class="col-sm-3">
                Comments
            </dt>

            <dd class="col-sm-9">
                @Model.Comments
            </dd>


            <dt class="col-sm-3">
                Feedback Date
            </dt>

            <dd class="col-sm-9">
                @Model.FeedbackDate.ToString("dd MMM yyyy hh:mm tt")
            </dd>

        </dl>

    </div>

</div>

<br />

<a asp-action="Delete"
   asp-route-id="@Model.Id"
   class="btn btn-danger">
    Delete
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back to Feedback
</a>