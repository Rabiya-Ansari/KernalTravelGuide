@model KernalTravelGuide.Models.Restaurant

@{
    ViewData["Title"] = "Restaurant Details";
}

<h1>Restaurant Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Name
    </dt>

    <dd class="col-sm-9">
        @Model.Name
    </dd>

    <dt class="col-sm-3">
        City
    </dt>

    <dd class="col-sm-9">
        @Model.City?.Name
    </dd>

    <dt class="col-sm-3">
        Rating
    </dt>

    <dd class="col-sm-9">
        @Model.Rating ⭐
    </dd>

    <dt class="col-sm-3">
        Phone
    </dt>

    <dd class="col-sm-9">
        @Model.Phone
    </dd>

    <dt class="col-sm-3">
        Image
    </dt>

    <dd class="col-sm-9">

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath"
                 alt="@Model.Name"
                 style="max-width:250px;" />
        }

    </dd>

</dl>

<div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>