@model KernalTravelGuide.Models.Restaurant

@{
    ViewData["Title"] = "Edit Restaurant";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">

    <h2 class="fw-bold">
        Edit Restaurant
    </h2>

    <p class="text-muted">
        Update restaurant information and image.
    </p>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body p-4">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>


            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   asp-for="ImagePath" />


            <div class="row">

                <!-- Name -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                        Restaurant Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>

                </div>


                <!-- City -->
                <div class="col-md-6 mb-3">

                    <label asp-for="CityId"
                           class="form-label fw-semibold">
                        City
                    </label>

                    <select asp-for="CityId"
                            asp-items="ViewBag.CityId"
                            class="form-select">

                        <option value="">
                            -- Select City --
                        </option>

                    </select>

                    <span asp-validation-for="CityId"
                          class="text-danger"></span>

                </div>


                <!-- Rating -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Rating"
                           class="form-label fw-semibold">
                        Rating
                    </label>

                    <input asp-for="Rating"
                           class="form-control"
                           type="number"
                           min="1"
                           max="5"
                           step="0.1" />

                    <span asp-validation-for="Rating"
                          class="text-danger"></span>

                </div>
                <div class="form-group mb-3">
                    <label asp-for="AveragePrice" class="control-label">
                        Average Price
                    </label>

                    <input asp-for="AveragePrice"
                           class="form-control"
                           min="100"
                           max="100000"
                           step="0.01" />

                    <span asp-validation-for="AveragePrice"
                          class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Capacity" class="control-label">
                        Seating Capacity
                    </label>

                    <input asp-for="Capacity"
                           class="form-control"
                           min="1"
                           max="5000" />

                    <span asp-validation-for="Capacity"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Availability"
                           class="form-check-input" />

                    <label asp-for="Availability"
                           class="form-check-label">
                        Available
                    </label>
                </div>


                <!-- Phone -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Phone"
                           class="form-label fw-semibold">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           class="form-control" />

                    <span asp-validation-for="Phone"
                          class="text-danger"></span>

                </div>


                <!-- Current Image -->
                <!-- Current Image -->
                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">
                        Current Image
                    </label>

                    <div>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Url.Content(Model.ImagePath)"
                                 alt="@Model.Name"
                                 style="
                            width:180px;
                            height:130px;
                            object-fit:cover;
                            border-radius:10px;
                            " />
                        }
                        else
                        {
                            <div class="text-muted">
                                No image uploaded.
                            </div>
                        }
                    </div>

                </div>


                <!-- Replace Image -->
                <div class="col-md-6 mb-3">

                    <label class="form-label fw-semibold">
                        Replace Image
                    </label>

                    <input type="file"
                           name="ImageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <small class="text-muted">
                        Select a new image if you want to replace the current image.
                    </small>

                    <span class="text-danger"
                          asp-validation-for="ImagePath"></span>

                </div>


            <div class="mt-3">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save me-1"></i>
                    Save Changes

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary ms-2">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}