@model IEnumerable<KernalTravelGuide.Models.Restaurant>

@{
    ViewData["Title"] = "Restaurants";
}

<h1>Restaurants</h1>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Add New Restaurant
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>City</th>
            <th>Rating</th>
            <th>Phone</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Name
                </td>

                <td>
                    @item.City?.Name
                </td>

                <td>
                    @item.Rating ⭐
                </td>

                <td>
                    @item.Phone
                </td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath"
                             alt="@item.Name"
                             style="width:80px;height:60px;object-fit:cover;" />
                    }
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>