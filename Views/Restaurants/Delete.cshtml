@model KernalTravelGuide.Models.Restaurant

@{
    ViewData["Title"] = "Delete Restaurant";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">

    <h2 class="fw-bold text-danger">
        Delete Restaurant
    </h2>

    <p class="text-muted">
        Please confirm that you want to delete this restaurant.
    </p>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body p-4">

        <div class="row align-items-center">

            <!-- Image -->
            <div class="col-md-3">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Url.Content(Model.ImagePath)"
                         alt="@Model.Name"
                         class="img-fluid rounded"
                         style="
                    width:200px;
                    height:140px;
                    object-fit:cover;
                    " />
                }
                else
                {
                    <div class="bg-light rounded d-flex
                        align-items-center
                        justify-content-center"
                         style="width:200px;height:140px;">

                        No Image

                    </div>
                }

            </div>


            <!-- Details -->
            <div class="col-md-9">

                <h4 class="fw-bold">
                    @Model.Name
                </h4>

                <p class="mb-1">
                    <strong>City:</strong>
                    @Model.City?.Name
                </p>

                <p class="mb-1">
                    <strong>Rating:</strong>
                    @Model.Rating ⭐
                </p>

                <p class="mb-3">
                    <strong>Phone:</strong>
                    @Model.Phone
                </p>


                <div class="alert alert-warning">

                    <i class="bi bi-exclamation-triangle me-1"></i>

                    Are you sure you want to delete this restaurant?
                    The uploaded image will also be permanently deleted.

                </div>


                <form asp-action="Delete"
                      method="post">

                    <input type="hidden"
                           asp-for="Id" />


                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Yes, Delete

                    </button>


                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">

                        Cancel

                    </a>

                </form>

            </div>

        </div>

    </div>

</div>