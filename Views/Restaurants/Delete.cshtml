@model KernalTravelGuide.Models.Restaurant

@{
    ViewData["Title"] = "Delete Restaurant";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Delete Restaurant</h1>

<h3>Are you sure you want to delete this restaurant?</h3>



<dl class="row">

    <dt class="col-sm-3">
        Name
    </dt>

    <dd class="col-sm-9">
        @Model.Name
    </dd>

    <dt class="col-sm-3">
        City
    </dt>

    <dd class="col-sm-9">
        @Model.City?.Name
    </dd>

    <dt class="col-sm-3">
        Rating
    </dt>

    <dd class="col-sm-9">
        @Model.Rating ⭐
    </dd>

    <dt class="col-sm-3">
        Phone
    </dt>

    <dd class="col-sm-9">
        @Model.Phone
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>