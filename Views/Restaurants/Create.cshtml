@model KernalTravelGuide.Models.Restaurant

@{
    ViewData["Title"] = "Create Restaurant";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Create Restaurant</h1>


<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <!-- Name -->
            <div class="form-group mb-3">
                <label asp-for="Name"
                       class="control-label">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <!-- City -->
            <div class="form-group mb-3">

                <label asp-for="CityId"
                       class="control-label">
                    City
                </label>

                <select asp-for="CityId"
                        class="form-control"
                        asp-items="ViewBag.CityId">

                    <option value="">
                        -- Select City --
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger"></span>

            </div>

            <!-- Rating -->
            <div class="form-group mb-3">

                <label asp-for="Rating"
                       class="control-label">
                </label>

                <input asp-for="Rating"
                       class="form-control"
                       type="number"
                       min="1"
                       max="5"
                       step="0.1" />

                <span asp-validation-for="Rating"
                      class="text-danger"></span>

            </div>

            <!-- Phone -->
            <div class="form-group mb-3">

                <label asp-for="Phone"
                       class="control-label">
                </label>

                <input asp-for="Phone"
                       class="form-control" />

                <span asp-validation-for="Phone"
                      class="text-danger"></span>

            </div>

            <!-- Image -->
            <div class="form-group mb-3">

                <label asp-for="ImagePath"
                       class="control-label">
                </label>

                <input asp-for="ImagePath"
                       class="form-control" />

                <span asp-validation-for="ImagePath"
                      class="text-danger"></span>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}