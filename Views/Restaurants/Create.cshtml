@model KernalTravelGuide.Models.Restaurant

@{
    ViewData["Title"] = "Create Restaurant";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">

    <h2 class="fw-bold">
        Add Restaurant
    </h2>

    <p class="text-muted">
        Add a new restaurant to the travel guide.
    </p>

</div>


<div class="card border-0 shadow-sm">

    <div class="card-body p-4">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>


            <div class="row">

                <!-- Name -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                        Restaurant Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter restaurant name" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>

                </div>


                <!-- City -->
                <div class="col-md-6 mb-3">

                    <label asp-for="CityId"
                           class="form-label fw-semibold">
                        City
                    </label>

                    <select asp-for="CityId"
                            asp-items="ViewBag.CityId"
                            class="form-select">

                        <option value="">
                            -- Select City --
                        </option>

                    </select>

                    <span asp-validation-for="CityId"
                          class="text-danger"></span>

                </div>


                <!-- Rating -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Rating"
                           class="form-label fw-semibold">
                        Rating
                    </label>

                    <input asp-for="Rating"
                           class="form-control"
                           type="number"
                           min="1"
                           max="5"
                           step="0.1"
                           placeholder="1 - 5" />

                    <span asp-validation-for="Rating"
                          class="text-danger"></span>

                </div>


                <!-- Phone -->
                <div class="col-md-6 mb-3">

                    <label asp-for="Phone"
                           class="form-label fw-semibold">
                        Phone
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Enter phone number" />

                    <span asp-validation-for="Phone"
                          class="text-danger"></span>

                </div>


                <!-- ACTUAL IMAGE -->
                <div class="col-12 mb-3">

                    <label class="form-label fw-semibold">
                        Restaurant Image
                    </label>

                    <input type="file"
                           name="ImageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <span class="text-muted small">
                        Allowed: JPG, JPEG, PNG, WEBP
                    </span>

                    <span asp-validation-for="ImagePath"
                          class="text-danger"></span>

                </div>

            </div>


            <div class="mt-3">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>
                    Create Restaurant

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary ms-2">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}