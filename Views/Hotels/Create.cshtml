@model KernalTravelGuide.Models.Hotel

@{
    ViewData["Title"] = "Add Hotel";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Add Hotel</h2>
            <p class="text-muted mb-0">
                Add a new hotel to your travel guide.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Hotel Name -->

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                        Hotel Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter hotel name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- City -->

                <div class="mb-3">

                    <label asp-for="CityId"
                           class="form-label fw-semibold">
                        City
                    </label>

                    <select asp-for="CityId"
                            class="form-select"
                            asp-items="ViewBag.CityId">

                        <option value="">
                            -- Select City --
                        </option>

                    </select>

                    <span asp-validation-for="CityId"
                          class="text-danger">
                    </span>

                </div>


                <div class="row">

                    <!-- Price -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="PricePerNight"
                               class="form-label fw-semibold">
                            Price Per Night
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                Rs.
                            </span>

                            <input asp-for="PricePerNight"
                                   type="number"
                                   class="form-control"
                                   placeholder="0" />

                        </div>

                        <span asp-validation-for="PricePerNight"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Star Rating -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="StarRating"
                               class="form-label fw-semibold">
                            Star Rating
                        </label>

                        <select asp-for="StarRating"
                                class="form-select">

                            <option value="">-- Select Rating --</option>
                            <option value="1">1 Star</option>
                            <option value="2">2 Stars</option>
                            <option value="3">3 Stars</option>
                            <option value="4">4 Stars</option>
                            <option value="5">5 Stars</option>

                        </select>

                        <span asp-validation-for="StarRating"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Contact + Email -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ContactNo"
                               class="form-label fw-semibold">
                            Contact Number
                        </label>

                        <input asp-for="ContactNo"
                               class="form-control"
                               placeholder="0300-1234567" />

                        <span asp-validation-for="ContactNo"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="hotel@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Website -->

                <div class="mb-3">

                    <label asp-for="Website"
                           class="form-label fw-semibold">
                        Website
                    </label>

                    <input asp-for="Website"
                           class="form-control"
                           placeholder="https://example.com" />

                    <span asp-validation-for="Website"
                          class="text-danger">
                    </span>

                </div>


                <!-- Image Path -->

                <div class="mb-3">

                    <label asp-for="ImagePath"
                           class="form-label fw-semibold">
                        Image Path
                    </label>

                    <input asp-for="ImagePath"
                           class="form-control"
                           placeholder="/images/hotels/hotel.jpg" />

                    <span asp-validation-for="ImagePath"
                          class="text-danger">
                    </span>

                </div>


                <!-- Availability -->

                <div class="form-check mb-4">

                    <input asp-for="Availability"
                           class="form-check-input" />

                    <label asp-for="Availability"
                           class="form-check-label">
                        Hotel is Available
                    </label>

                </div>


                <!-- Buttons -->

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-circle me-1"></i>
                    Save Hotel

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}