@model KernalTravelGuide.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Hotel Details</h2>
            <p class="text-muted mb-0">
                View complete hotel information.
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary me-2">
                <i class="bi bi-pencil me-1"></i>
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="row">

                <!-- Hotel Information -->

                <div class="col-lg-8">

                    <h3 class="fw-bold mb-4">
                        @Model.Name
                    </h3>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                City
                            </small>

                            <strong>
                                <i class="bi bi-geo-alt me-1"></i>
                                @(Model.City?.Name ?? "N/A")
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Price Per Night
                            </small>

                            <strong>
                                Rs. @Model.PricePerNight.ToString("N0")
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Star Rating
                            </small>

                            <span class="text-warning">

                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Model.StarRating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }

                            </span>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Availability
                            </small>

                            @if (Model.Availability)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Unavailable
                                </span>
                            }
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Contact Number
                            </small>

                            <strong>
                                @Model.ContactNo
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Email
                            </small>

                            <strong>
                                @Model.Email
                            </strong>
                        </div>

                        <div class="col-12">
                            <small class="text-muted d-block">
                                Website
                            </small>

                            @if (!string.IsNullOrEmpty(Model.Website))
                            {
                                <a href="@Model.Website"
                                   target="_blank">
                                    @Model.Website
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not provided
                                </span>
                            }
                        </div>

                        <div class="col-12">
                            <small class="text-muted d-block">
                                Image Path
                            </small>

                            <span>
                                @(string.IsNullOrEmpty(Model.ImagePath)
                                    ? "Not provided"
                                    : Model.ImagePath)
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>