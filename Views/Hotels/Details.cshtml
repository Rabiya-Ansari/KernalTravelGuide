@model KernalTravelGuide.Models.Hotel

@{
    ViewData["Title"] = "Hotel Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Hotel Details</h1>

<div class="row">

    <div class="col-md-5">

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath"
                 alt="@Model.Name"
                 style="width:100%;max-width:400px;height:260px;object-fit:cover;border-radius:10px;" />
        }
        else
        {
            <p>No image available.</p>
        }

    </div>

    <div class="col-md-7">

        <dl class="row">

            <dt class="col-sm-4">
                Hotel Name
            </dt>

            <dd class="col-sm-8">
                @Model.Name
            </dd>

            <dt class="col-sm-4">
                City
            </dt>

            <dd class="col-sm-8">
                @Model.City?.Name
            </dd>

            <dt class="col-sm-4">
                Price Per Night
            </dt>

            <dd class="col-sm-8">
                @Model.PricePerNight
            </dd>

            <dt class="col-sm-4">
                Star Rating
            </dt>

            <dd class="col-sm-8">
                @Model.StarRating ⭐
            </dd>

            <dt class="col-sm-4">
                Contact
            </dt>

            <dd class="col-sm-8">
                @Model.ContactNo
            </dd>

            <dt class="col-sm-4">
                Email
            </dt>

            <dd class="col-sm-8">
                @Model.Email
            </dd>

            <dt class="col-sm-4">
                Website
            </dt>

            <dd class="col-sm-8">
                @Model.Website
            </dd>

            <dt class="col-sm-4">
                Availability
            </dt>

            <dd class="col-sm-8">
                @if (Model.Availability)
                {
                    <span class="badge bg-success">
                        Available
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Not Available
                    </span>
                }
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
        

    </div>

</div>