@model KernalTravelGuide.Models.Hotel

@{
    ViewData["Title"] = "Delete Hotel";
}

<h1>Delete Hotel</h1>

<h3>Are you sure you want to delete this hotel?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">City</dt>
    <dd class="col-sm-9">@Model.City?.Name</dd>

    <dt class="col-sm-3">Price Per Night</dt>
    <dd class="col-sm-9">@Model.PricePerNight</dd>

    <dt class="col-sm-3">Star Rating</dt>
    <dd class="col-sm-9">@Model.StarRating ⭐</dd>

    <dt class="col-sm-3">Contact</dt>
    <dd class="col-sm-9">@Model.ContactNo</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Availability</dt>
    <dd class="col-sm-9">
        @(Model.Availability ? "Available" : "Not Available")
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>