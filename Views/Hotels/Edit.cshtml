@model KernalTravelGuide.Models.Hotel

@{
    ViewData["Title"] = "Edit Hotel";
}

<h1>Edit Hotel</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <!-- Name -->
            <div class="form-group mb-3">
                <label asp-for="Name"
                       class="control-label">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <!-- City -->
            <div class="form-group mb-3">
                <label asp-for="CityId"
                       class="control-label">
                    City
                </label>

                <select asp-for="CityId"
                        class="form-control"
                        asp-items="ViewBag.CityId">

                    <option value="">
                        -- Select City --
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="form-group mb-3">
                <label asp-for="PricePerNight"
                       class="control-label">
                </label>

                <input asp-for="PricePerNight"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="PricePerNight"
                      class="text-danger"></span>
            </div>

            <!-- Stars -->
            <div class="form-group mb-3">
                <label asp-for="StarRating"
                       class="control-label">
                </label>

                <input asp-for="StarRating"
                       class="form-control"
                       type="number"
                       min="1"
                       max="5" />

                <span asp-validation-for="StarRating"
                      class="text-danger"></span>
            </div>

            <!-- Contact -->
            <div class="form-group mb-3">
                <label asp-for="ContactNo"
                       class="control-label">
                </label>

                <input asp-for="ContactNo"
                       class="form-control" />

                <span asp-validation-for="ContactNo"
                      class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label asp-for="Email"
                       class="control-label">
                </label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <!-- Website -->
            <div class="form-group mb-3">
                <label asp-for="Website"
                       class="control-label">
                </label>

                <input asp-for="Website"
                       class="form-control" />

                <span asp-validation-for="Website"
                      class="text-danger"></span>
            </div>

            <!-- Image -->
            <div class="form-group mb-3">
                <label asp-for="ImagePath"
                       class="control-label">
                </label>

                <input asp-for="ImagePath"
                       class="form-control" />

                <span asp-validation-for="ImagePath"
                      class="text-danger"></span>
            </div>

            <!-- Availability -->
            <div class="form-check mb-3">

                <input asp-for="Availability"
                       class="form-check-input" />

                <label asp-for="Availability"
                       class="form-check-label">
                </label>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}