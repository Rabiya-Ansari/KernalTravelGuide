@model KernalTravelGuide.Models.TouristSpot

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = Model.Name + " - Details";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Tourist Spot Details</h1>
                    <p class="text-white">
                        Discover more about this amazing destination.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="untree_co-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 p-4">

                    <!-- Tourist Spot Image -->
                    <div class="mb-4 text-center">
                        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                        {
                            <img src="@Url.Content(Model.ImagePath)" alt="@Model.Name" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/client/assets/images/hero-slider-1.jpg" alt="@Model.Name" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;" />
                        }
                    </div>

                    <!-- Spot Name & Location -->
                    <h2 class="text-primary mb-2">@Model.Name</h2>

                    <p class="text-muted mb-4">
                        <i class="icon-room text-primary"></i> @(Model.City?.Name ?? "Pakistan")
                    </p>

                    <hr />

                    <!-- Spot Description / Information -->
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="bg-light p-3 rounded mb-4">
                            <h5 class="font-weight-bold mb-2">About Destination</h5>
                            <p class="mb-0 text-muted">
                                @Model.Description
                            </p>
                        </div>
                    }

                    <!-- Actions Buttons -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            Back to Tourist Spots
                        </a>

                        <div>
                            @if (User.IsInRole("Customer"))
                            {
                                <a asp-controller="Feedback"
                                   asp-action="Create"
                                   asp-route-touristSpotId="@Model.Id"
                                   class="btn btn-outline-primary">
                                    <i class="fa fa-star"></i> Give Your Review
                                </a>
                            }
                            <a asp-controller="PublicTouristSpots"
                               asp-action="BookNow"
                               asp-route-touristSpotId="@Model.Id"
                               class="btn btn-primary btn-lg">
                                Book Visit Now
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>