@model KernalTravelGuide.Models.ViewModels.HomeViewModel

@{
	Layout = "_ClientLayout";
	ViewData["Title"] = "Tourist Spots Page";
}

<div class="hero hero-inner">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-lg-6 mx-auto text-center">
				<div class="intro-wrap">
					<h1 class="mb-0">Popular Tourist Spots</h1>
					<p class="text-white">
						Explore beautiful destinations and discover amazing places
						available through Karnel Travel Guide.
					</p>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Popular Tourist Spots section -->
<div class="untree_co-section">
	<div class="container">

		<!-- Section heading -->
		<div class="row text-center justify-content-center mb-5">
			<div class="col-lg-7">
				<h2 class="section-title text-center">
					Popular Tourist Spots
				</h2>
				<p class="text-muted">
					Explore beautiful destinations and discover amazing places
					available through Karnel Travel Guide.
				</p>
			</div>
		</div>

		<!-- Tourist spot carousel -->
		<div class="owl-3-slider owl-carousel">

			@if (Model?.TouristSpots != null && Model.TouristSpots.Any())
			{
				foreach (var spot in Model.TouristSpots)
				{
					<div class="item">
						<div class="media-1 h-100 shadow-sm rounded p-3 bg-white d-flex flex-column">

							<!-- Tourist spot image -->
							<a asp-controller="PublicTouristSpots"
							   asp-action="Details"
							   asp-route-id="@spot.Id"
							   class="d-block mb-3">

								@if (!string.IsNullOrWhiteSpace(spot.ImagePath))
								{
									<img src="@Url.Content(spot.ImagePath)"
										 alt="@spot.Name"
										 class="img-fluid rounded" style="height: 200px; width: 100%; object-fit: cover;" />
								}
								else
								{
									<img src="~/client/assets/images/hero-slider-1.jpg"
										 alt="@spot.Name"
										 class="img-fluid rounded" style="height: 200px; width: 100%; object-fit: cover;" />
								}

							</a>

							<div class="d-flex flex-column flex-grow-1">
								<!-- Location -->
								<span class="d-flex align-items-center loc mb-2 text-muted small">
									<span class="icon-room mr-2 text-primary"></span>
									<span>
										@(spot.City?.Name ?? "Pakistan")
									</span>
								</span>

								<!-- Tourist spot name -->
								<h3 class="h5 mb-3">
									<a asp-controller="PublicTouristSpots"
									   asp-action="Details"
									   asp-route-id="@spot.Id" class="text-dark">
										@spot.Name
									</a>
								</h3>

								<!-- Action Button -->
								<div class="mt-auto pt-2">
									<a asp-controller="PublicTouristSpots"
									   asp-action="Details"
									   asp-route-id="@spot.Id"
									   class="btn btn-primary btn-sm btn-block">
										View Details
									</a>
								</div>
							</div>

						</div>
					</div>
				}
			}
			else
			{
				<!-- Empty state -->
				<div class="item">
					<div class="text-center py-5">
						<i class="icon-map-marker display-4 text-muted"></i>
						<h4 class="mt-3">
							No tourist spots available
						</h4>
						<p class="text-muted">
							Tourist destinations will appear here once they are added.
						</p>
					</div>
				</div>
			}

		</div>

	</div>
</div>