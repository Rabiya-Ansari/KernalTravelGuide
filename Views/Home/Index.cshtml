<div class="untree_co-section count-numbers py-5">
	<div class="container">
		<div class="row">

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.TouristSpotCount">
							@Model.TouristSpotCount
						</span>
					</div>
					<span class="caption">Tourist Spots</span>
				</div>
			</div>

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.HotelCount">
							@Model.HotelCount
						</span>
					</div>
					<span class="caption">Hotels</span>
				</div>
			</div>

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.RestaurantCount">
							@Model.RestaurantCount
						</span>
					</div>
					<span class="caption">Restaurants</span>
				</div>
			</div>

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.ResortCount">
							@Model.ResortCount
						</span>
					</div>
					<span class="caption">Resorts</span>
				</div>
			</div>

		</div>
	</div>
</div>



<div class="untree_co-section">
	<div class="container">
		<div class="row text-center justify-content-center mb-5">
			<div class="col-lg-7"><h2 class="section-title text-center">Popular Destination</h2></div>
		</div>

		<div class="owl-single owl-carousel no-nav">

			@foreach (var review in Model.Reviews)
			{
				<div class="testimonial mx-auto">

					<h3 class="name">
						@(review.User == null
							? "Customer"
							: $"{review.User.FirstName} {review.User.LastName}")
					</h3>

					<div class="mb-3 text-warning">

						@for (int i = 1; i <= 5; i++)
						{
							if (i <= review.Rating)
							{
								<i class="bi bi-star-fill"></i>
							}
							else
							{
								<i class="bi bi-star"></i>
							}
						}

					</div>

					<blockquote>

						<p>
							&ldquo;@review.Comment&rdquo;
						</p>

					</blockquote>

				</div>
			}

		</div>

	</div>
</div>


