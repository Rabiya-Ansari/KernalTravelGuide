			@if (Model.Hotels.Any())
			{
				foreach (var hotel in Model.Hotels)
				{
					<div class="col-6 col-md-6 col-lg-3 mb-4">

						<div class="media-1 h-100">

							<!-- Hotel image -->
							<a asp-controller="Hotels"
							   asp-action="Details"
							   asp-route-id="@hotel.Id"
							   class="d-block mb-3">

								@if (!string.IsNullOrWhiteSpace(hotel.ImagePath))
								{
									<img src="@Url.Content(hotel.ImagePath)"
										 alt="@hotel.Name"
										 class="img-fluid" />
								}
								else
								{
									<img src="~/client/assets/images/hero-slider-1.jpg"
										 alt="@hotel.Name"
										 class="img-fluid" />
								}

							</a>


							<!-- Hotel information -->
							<div>

								<h3>

									<a asp-controller="Hotels"
									   asp-action="Details"
									   asp-route-id="@hotel.Id">

										@hotel.Name

									</a>

								</h3>


								<!-- Hotel location -->
								<span class="d-flex align-items-center loc mb-2">

									<span class="icon-room mr-2"></span>

									<span>
										@(hotel.City?.Name ?? "Pakistan")
									</span>

								</span>


								<!-- View hotel -->
								<a asp-controller="Hotels"
								   asp-action="Details"
								   asp-route-id="@hotel.Id"
								   class="btn btn-primary btn-sm mt-2">

									View Hotel

								</a>

							</div>

						</div>

					</div>
				}
			}
			else
			{
				<!-- Empty state -->
				<div class="col-12">

					<div class="text-center py-5">

						<h4>
							No hotels available
