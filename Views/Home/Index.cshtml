									   asp-action="Details"
									   asp-route-id="@package.Id"
									   class="btn btn-primary btn-sm">

										View Package

									</a> *@
									<a asp-controller="MyBookings"
									   asp-action="Create"
									   asp-route-tourPackageId="@package.Id"
									   class="btn btn-primary">

										Book Now

									</a>

								</div>

							</div>

						</div>

