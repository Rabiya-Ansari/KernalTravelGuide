						<p class="text-muted">
							Hotels will appear here when they are added.
						</p>

					</div>

				</div>
			}

		</div>


		<!-- View all hotels -->
		<div class="text-center mt-4">

			<a asp-controller="Hotels"
			   asp-action="Index"
			   class="btn btn-outline-primary">

				View All Hotels

			</a>

		</div>

	</div>

</div>

