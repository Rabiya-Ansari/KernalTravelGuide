@model KernalTravelGuide.Models.ViewModels.HomeViewModel


@{
	Layout = "_ClientLayout";
    ViewData["Title"] = "Home Page";
}

<div class="hero">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-lg-7">
				<div class="intro-wrap">
					<h1 class="mb-5"><span class="d-block">Let's Enjoy Your</span> Trip In <span class="typed-words"></span></h1>

					<div class="row">
						<div class="col-12">
							<form asp-controller="Search"
								  asp-action="Index"
								  method="get"
								  class="form">

								<div class="row mb-2">

									<div class="col-sm-12 col-md-6 mb-3 mb-lg-0 col-lg-4">

										<input type="text"
											   name="query"
											   class="form-control"
											   placeholder="Search destination..." />

									</div>

									<div class="col-sm-12 col-md-6 mb-3 mb-lg-0 col-lg-5">

										<select name="type"
												class="form-control custom-select">

											<option value="">All Categories</option>
											<option value="TouristSpot">Tourist Spots</option>
											<option value="Hotel">Hotels</option>
											<option value="Restaurant">Restaurants</option>
											<option value="Resort">Resorts</option>

										</select>

									</div>

									<div class="col-sm-12 col-md-6 mb-3 mb-lg-0 col-lg-3">

										<button type="submit"
												class="btn btn-primary btn-block">

											Search

										</button>

									</div>

								</div>

							</form>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-5">
				<div class="slides">
					<img src="~/client/assets/images/hero-slider-1.jpg" alt="Image" class="img-fluid active">
					<img src="~/client/assets/images/hero-slider-2.jpg" alt="Image" class="img-fluid">
					<img src="~/client/assets/images/hero-slider-3.jpg" alt="Image" class="img-fluid">
					<img src="~/client/assets/images/hero-slider-4.jpg" alt="Image" class="img-fluid">
					<img src="~/client/assets/images/hero-slider-5.jpg" alt="Image" class="img-fluid">
				</div>
			</div>
		</div>
	</div>
</div>


<!-- Services Section -->
<div class="untree_co-section">

	<div class="container">

		<!-- Section heading -->
		<div class="row mb-5 justify-content-center">

			<div class="col-lg-6 text-center">

				<h2 class="section-title text-center mb-3">
					Our Services
				</h2>

				<p>
					Explore destinations, discover places to stay and eat,
					find exciting tour packages, and plan your journey with
					Kernal Travel Guide.
				</p>

			</div>

		</div>


		<div class="row align-items-stretch">

			<!-- Center image -->
			<div class="col-lg-4 order-lg-1">

				<div class="h-100">

					<div class="frame h-100">

						<div class="feature-img-bg h-100"
							 style="background-image: url('@Url.Content("~/client/assets/images/hero-slider-1.jpg")');">
						</div>

					</div>

				</div>

			</div>


			<!-- Left services -->
			<div class="col-6 col-sm-6 col-lg-4 feature-1-wrap d-md-flex flex-md-column order-lg-1">

				<!-- Service 1 -->
				<div class="feature-1 d-md-flex">

					<div class="align-self-center">

						<span class="flaticon-house display-4 text-primary"></span>

						<h3>
							Find Hotels
						</h3>

						<p class="mb-0">
							Discover comfortable hotels in your preferred
							destination and choose the right place to stay.
						</p>

					</div>

				</div>


				<!-- Service 2 -->
				<div class="feature-1">

					<div class="align-self-center">

						<span class="flaticon-restaurant display-4 text-primary"></span>

						<h3>
							Restaurants & Dining
						</h3>

						<p class="mb-0">
							Explore restaurants and cafes and discover
							great dining options during your journey.
						</p>

					</div>

				</div>

			</div>


			<!-- Right services -->
			<div class="col-6 col-sm-6 col-lg-4 feature-1-wrap d-md-flex flex-md-column order-lg-3">

				<!-- Service 3 -->
				<div class="feature-1 d-md-flex">

					<div class="align-self-center">

						<span class="flaticon-mail display-4 text-primary"></span>

						<h3>
							Tour Packages
						</h3>

						<p class="mb-0">
							Explore available tour packages and find
							experiences that match your travel plans.
						</p>

					</div>

				</div>


				<!-- Service 4 -->
				<div class="feature-1 d-md-flex">

					<div class="align-self-center">

						<span class="flaticon-phone-call display-4 text-primary"></span>

						<h3>
							Travel Support
						</h3>

						<p class="mb-0">
							Get useful travel information and assistance
							while planning your next journey.
						</p>

					</div>

				</div>

			</div>

		</div>

	</div>

</div>

<div class="untree_co-section count-numbers py-5">
	<div class="container">
		<div class="row">

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.TouristSpotCount">
							@Model.TouristSpotCount
						</span>
					</div>
					<span class="caption">Tourist Spots</span>
				</div>
			</div>

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.HotelCount">
							@Model.HotelCount
						</span>
					</div>
					<span class="caption">Hotels</span>
				</div>
			</div>

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.RestaurantCount">
							@Model.RestaurantCount
						</span>
					</div>
					<span class="caption">Restaurants</span>
				</div>
			</div>

			<div class="col-6 col-lg-3">
				<div class="counter-wrap">
					<div class="counter">
						<span data-number="@Model.ResortCount">
							@Model.ResortCount
						</span>
					</div>
					<span class="caption">Resorts</span>
				</div>
			</div>

		</div>
	</div>
</div>



<!-- Popular Tourist Spots section -->
<div class="untree_co-section">

	<div class="container">

		<!-- Section heading -->
		<div class="row text-center justify-content-center mb-5">

			<div class="col-lg-7">

				<h2 class="section-title text-center">
					Popular Tourist Spots
				</h2>

				<p class="text-muted">
					Explore beautiful destinations and discover amazing places
					available through Karnel Travel Guide.
				</p>

			</div>

		</div>


		<!-- Tourist spot carousel -->
		<div class="owl-3-slider owl-carousel">

			@if (Model.TouristSpots.Any())
			{
				foreach (var spot in Model.TouristSpots)
				{
					<div class="item">

						<div class="media-1">

							<!-- Tourist spot image -->
							<a asp-controller="TouristSpots"
							   asp-action="Details"
							   asp-route-id="@spot.Id"
							   class="d-block mb-3">

								@if (!string.IsNullOrWhiteSpace(spot.ImagePath))
								{
									<img src="@Url.Content(spot.ImagePath)"
										 alt="@spot.Name"
										 class="img-fluid" />
								}
								else
								{
									<img src="~/client/assets/images/hero-slider-1.jpg"
										 alt="@spot.Name"
										 class="img-fluid" />
								}

							</a>


							<!-- Location -->
							<span class="d-flex align-items-center loc mb-2">

								<span class="icon-room mr-3"></span>

								<span>
									@(spot.City?.Name ?? "Pakistan")
								</span>

							</span>


							<!-- Tourist spot name -->
							<div class="d-flex align-items-center">

								<div>

									<h3>

										<a asp-controller="TouristSpots"
										   asp-action="Details"
										   asp-route-id="@spot.Id">

											@spot.Name

										</a>

									</h3>

								</div>

							</div>

						</div>

					</div>
				}
			}
			else
			{
				<!-- Empty state -->
				<div class="item">

					<div class="text-center py-5">

						<i class="icon-map-marker display-4 text-muted"></i>

						<h4 class="mt-3">
							No tourist spots available
						</h4>

						<p class="text-muted">
							Tourist destinations will appear here once they are added.
						</p>

					</div>

				</div>
			}

		</div>

	</div>

</div>

<!-- Dynamic Resorts section -->
<div class="untree_co-section">

	<div class="container">

		<!-- Section heading -->
		<div class="row justify-content-center text-center mb-5">

			<div class="col-lg-6">

				<h2 class="section-title text-center mb-3">
					Featured Resorts
				</h2>

				<p class="text-muted">
					Relax, unwind and discover beautiful resorts
					available at your favorite destinations.
				</p>

			</div>

		</div>


		<!-- Resort cards -->
		<div class="row">

			@if (Model.Resorts.Any())
			{
				foreach (var resort in Model.Resorts)
				{
					<div class="col-6 col-md-6 col-lg-3 mb-4">

						<div class="media-1 h-100">

							<!-- Resort image -->
							<a asp-controller="Resorts"
							   asp-action="Details"
							   asp-route-id="@resort.Id"
							   class="d-block mb-3">

								@if (!string.IsNullOrWhiteSpace(resort.ImagePath))
								{
									<img src="@Url.Content(resort.ImagePath)"
										 alt="@resort.Name"
										 class="img-fluid" />
								}
								else
								{
									<img src="~/client/assets/images/hero-slider-1.jpg"
										 alt="@resort.Name"
										 class="img-fluid" />
								}

							</a>


							<!-- Resort information -->
							<div>

								<!-- Resort name -->
								<h3>

									<a asp-controller="Resorts"
									   asp-action="Details"
									   asp-route-id="@resort.Id">

										@resort.Name

									</a>

								</h3>


								<!-- Resort location -->
								<span class="d-flex align-items-center loc mb-2">

									<span class="icon-room mr-2"></span>

									<span>
										@(resort.City?.Name ?? "Pakistan")
									</span>

								</span>


								<!-- View resort button -->
								<a asp-controller="Resorts"
								   asp-action="Details"
								   asp-route-id="@resort.Id"
								   class="btn btn-primary btn-sm mt-2">

									View Resort

								</a>

							</div>

						</div>

					</div>
				}
			}
			else
			{
				<!-- Empty state -->
				<div class="col-12">

					<div class="text-center py-5">

						<h4>
							No resorts available
						</h4>

						<p class="text-muted">
							Resorts will appear here when they are added.
						</p>

					</div>

				</div>
			}

		</div>


		<!-- View all resorts -->
		<div class="text-center mt-4">

			<a asp-controller="Resorts"
			   asp-action="Index"
			   class="btn btn-outline-primary">

				View All Resorts

			</a>

		</div>

	</div>

</div>
<!-- Customer testimonials section -->
<div class="untree_co-section testimonial-section mt-5">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-7 text-center">

				<h2 class="section-title text-center mb-5">
					What Our Customers Say
				</h2>

				<div class="owl-single owl-carousel no-nav">

					@if (Model?.Reviews != null && Model.Reviews.Any())
					{
						foreach (var review in Model.Reviews)
						{
							<div class="testimonial mx-auto">

								<!-- Customer Avatar -->
								<figure class="img-wrap mb-3">
									<img src="~/client/assets/images/person_2.jpg"
										 alt="@review.CustomerName"
										 class="img-fluid rounded-circle" style="width: 80px; height: 80px; object-fit: cover;">
								</figure>

								<!-- Customer Name -->
								<h3 class="name font-weight-bold mb-2">
									@(string.IsNullOrWhiteSpace(review.CustomerName) ? "Happy Customer" : review.CustomerName)
								</h3>

								<!-- Target Item Reviewed (Optional Badge) -->
								<div class="mb-2">
									@if (review.Hotel != null)
									{
										<span class="badge bg-primary text-white">Hotel: @review.Hotel.Name</span>
									}
									else if (review.Resort != null)
									{

										<span class="badge bg-info text-white">Resort: @review.Resort.Name</span>
									}
									else if (review.Restaurant != null)
									{

										<span class="badge bg-warning text-dark">Restaurant: @review.Restaurant.Name</span>
									}
									else if (review.TouristSpot != null)
									{

										<span class="badge bg-success text-white">Spot: @review.TouristSpot.Name</span>
									}
									else if (review.TourPackage != null)
									{

										<span class="badge bg-secondary text-white">Package: @review.TourPackage.PackageName</span>
									}
								</div>

								<!-- Rating Stars -->
								<div class="mb-3 text-warning">
									@for (int i = 1; i <= 5; i++)
									{
										if (i <= review.Rating)
										{
											<span class="icon-star text-warning"></span>
										}
										else
										{
											<span class="icon-star-o text-muted"></span>
										}
									}
								</div>

								<!-- Customer Comments -->
								<blockquote>
									<p class="px-3">&ldquo;@review.Comments&rdquo;</p>
								</blockquote>

							</div>
						}
					}
					else
					{
						<div class="testimonial mx-auto">
							<h3 class="name">Our Customers</h3>
							<blockquote>
								<p>Customer reviews will appear here once submitted.</p>
							</blockquote>
						</div>
					}

				</div>

			</div>
		</div>
	</div>
</div>

