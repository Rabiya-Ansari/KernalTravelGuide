@model IEnumerable<KernalTravelGuide.Models.TourPackage>

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Special Offers & Tour Packages";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Public Tour Packages</h1>
                    <p class="text-white">
                        Discover our available tour packages and find the right travel experience for your next journey.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="untree_co-section">
    <div class="container">

        <!-- Section heading -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-6">
                <h2 class="section-title text-center mb-3">
                    Special Offers & Tour Packages
                </h2>
                <p class="text-muted">
                    Discover our available tour packages and find the right travel experience for your next journey.
                </p>
            </div>
        </div>

        <!-- Tour package cards -->
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var package in Model)
                {
                    <div class="col-6 col-sm-6 col-md-6 col-lg-3 mb-4">
                        <div class="media-1 h-100 shadow-sm rounded p-3 bg-white d-flex flex-column">

                            <!-- Package image -->
                            <a asp-controller="PublicTourPackages"
                               asp-action="Details"
                               asp-route-id="@package.Id"
                               class="d-block mb-3">
                                @if (!string.IsNullOrWhiteSpace(package.ImagePath))
                                {
                                    <img src="@Url.Content(package.ImagePath)"
                                         alt="@package.PackageName"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="~/client/assets/images/hero-slider-1.jpg"
                                         alt="@package.PackageName"
                                         class="img-fluid rounded" style="height: 180px; width: 100%; object-fit: cover;" />
                                }
                            </a>

                            <!-- Package information -->
                            <div class="d-flex flex-column flex-grow-1">
                                <h3 class="h5">
                                    <a asp-controller="PublicTourPackages"
                                       asp-action="Details"
                                       asp-route-id="@package.Id" class="text-dark">
                                        @package.PackageName
                                    </a>
                                </h3>

                                <!-- Package price -->
                                <div class="price my-2 font-weight-bold text-success h5">
                                    <span>
                                        PKR @string.Format("{0:N0}", package.Price)
                                    </span>
                                </div>

                                <!-- Action Button -->
                                <div class="mt-auto pt-3">
                                    <a asp-controller="PublicTourPackages"
                                       asp-action="Details"
                                       asp-route-id="@package.Id"
                                       class="btn btn-primary btn-sm btn-block">
                                        View Details
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty state when no packages exist -->
                <div class="col-12 text-center py-5">
                    <i class="icon-map display-4 text-muted"></i>
                    <h4 class="mt-3">No tour packages available</h4>
                    <p class="text-muted">
                        New tour packages will appear here when they are added.
                    </p>
                </div>
            }
        </div>

    </div>
</div>