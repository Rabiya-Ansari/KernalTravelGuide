@using Microsoft.AspNetCore.Identity
@using KernalTravelGuide.Data
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);

    var customerName = "Traveler";

    if (currentUser != null)
    {
        var fullName = $"{currentUser.FirstName} {currentUser.LastName}".Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            customerName = fullName;
        }
        else if (!string.IsNullOrWhiteSpace(currentUser.Email))
        {
            customerName = currentUser.Email;
        }
    }

    var customerAvatar = Url.Content(
        "~/dashboard/assets/images/avatar/avatar.jpg");
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Kernal Travel Guide
    </title>

    <link rel="stylesheet"
          href="@Url.Content("~/dashboard/assets/css/bootstrap.min.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/dashboard/assets/css/style.css")" />

    @RenderSection("Styles", required: false)

</head>

<body>

    <div class="admin-layout">

        <!-- ================= SIDEBAR ================= -->

        <aside class="admin-sidebar"
               id="adminSidebar"
               aria-label="Customer navigation">

            <!-- Logo -->

            <div class="sidebar-header">

                <a class="brand-mark"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   aria-label="Customer Dashboard">

                    <span class="brand-icon">

                        <i class="bi bi-airplane-fill"
                           aria-hidden="true"></i>

                    </span>

                    <span class="brand-copy">

                        <span class="brand-title">
                            Kernal Travel
                        </span>

                        <span class="brand-subtitle">
                            Traveler Dashboard
                        </span>

                    </span>

                </a>

            </div>


            <!-- ================= CUSTOMER NAVIGATION ================= -->

            <nav class="sidebar-nav">

                <!-- Dashboard -->
                <a class="nav-link"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-speedometer2"></i>
                    </span>
                    <span class="nav-text">
                        Dashboard
                    </span>
                </a>


                <!-- Home -->
                <a class="nav-link"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-house"></i>
                    </span>
                    <span class="nav-text">
                        Home
                    </span>
                </a>


                @* <!-- Tour Packages (Changed to Public Controller) -->
                <a class="nav-link"
                   asp-controller="PublicTourPackages"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-map"></i>
                    </span>
                    <span class="nav-text">
                        Tour Packages
                    </span>
                </a>


                <!-- Tourist Spots (Changed to Public Controller) -->
                <a class="nav-link"
                   asp-controller="PublicTouristSpots"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-geo-alt"></i>
                    </span>
                    <span class="nav-text">
                        Tourist Spots
                    </span>
                </a>


                <!-- Hotels (Changed to Public Controller) -->
                <a class="nav-link"
                   asp-controller="PublicHotels"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-building"></i>
                    </span>
                    <span class="nav-text">
                        Hotels
                    </span>
                </a>


                <!-- Restaurants (Changed to Public Controller) -->
                <a class="nav-link"
                   asp-controller="PublicRestaurants"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-cup-hot"></i>
                    </span>
                    <span class="nav-text">
                        Restaurants
                    </span>
                </a>


                <!-- Resorts (Changed to Public Controller) -->
                <a class="nav-link"
                   asp-controller="PublicResorts"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-house-heart"></i>
                    </span>
                    <span class="nav-text">
                        Resorts
                    </span>
                </a>


                <!-- Travel Information (Added Public Controller Link) -->
                <a class="nav-link"
                   asp-controller="PublicTravelInformation"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-info-circle"></i>
                    </span>
                    <span class="nav-text">
                        Travel Info
                    </span>
                </a> *@


                <!-- My Bookings (User specific data) -->
                <a class="nav-link"
                   asp-controller="MyBookings"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-calendar-check"></i>
                    </span>
                    <span class="nav-text">
                        My Bookings
                    </span>
                </a>


                <!-- My Feedbacks (User specific data) -->
                <a class="nav-link"
                   asp-controller="Feedback"
                   asp-action="MyFeedbacks">
                    <span class="nav-icon">
                        <i class="bi bi-chat-text"></i>
                    </span>
                    <span class="nav-text">
                        My Feedbacks
                    </span>
                </a>

            </nav>


            <!-- ================= SIDEBAR USER ================= -->

            <div class="sidebar-user">

                <img class="avatar-img avatar-md sidebar-user-avatar"
                     src="@customerAvatar"
                     alt="Traveler" />

                <strong>
                    @customerName
                </strong>

                <small>
                    Traveler Account
                </small>

            </div>


            <!-- ================= SIDEBAR FOOTER ================= -->

            <div class="sidebar-footer">

                <span class="status-dot"></span>

                <span class="sidebar-footer-text">
                    Travel account active
                </span>

            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <div class="admin-main">


            <!-- ================= NAVBAR ================= -->

            <nav class="navbar admin-navbar navbar-expand bg-white">

                <div class="container-fluid px-3 px-lg-4">


                    <!-- Sidebar Toggle -->

                    <button class="sidebar-toggle"
                            type="button"
                            data-sidebar-toggle
                            aria-controls="adminSidebar"
                            aria-expanded="true"
                            aria-label="Toggle sidebar">

                        <span></span>
                        <span></span>
                        <span></span>

                    </button>


                    <!-- Search -->

                    <form class="d-none d-md-flex ms-3 flex-grow-1"
                          role="search">

                        <input class="form-control search-input"
                               type="search"
                               placeholder="Search destinations, hotels, tours"
                               aria-label="Search" />

                    </form>


                    <!-- Navbar Actions -->

                    <div class="navbar-actions ms-auto">


                        <!-- Theme -->

                        <button class="icon-button theme-toggle"
                                type="button"
                                data-theme-toggle
                                aria-label="Switch color theme"
                                title="Switch color theme">

                            <i class="bi bi-moon-stars"
                               data-theme-icon
                               aria-hidden="true"></i>

                        </button>


                        <!-- Notifications -->

                        <div class="dropdown">

                            <button class="icon-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Notifications">

                                <i class="bi bi-bell"
                                   aria-hidden="true"></i>

                            </button>

                            <div class="dropdown-menu dropdown-menu-end notification-menu">

                                <div class="dropdown-header fw-bold text-body">
                                    Travel Updates
                                </div>

                                <a class="dropdown-item"
                                   asp-controller="MyBookings"
                                   asp-action="Index">

                                    <span class="notification-title">
                                        My Bookings
                                    </span>

                                    <span class="notification-time">
                                        View booking status
                                    </span>

                                </a>

                                <a class="dropdown-item"
                                   asp-controller="TourPackages"
                                   asp-action="Index">

                                    <span class="notification-title">
                                        Tour Packages
                                    </span>

                                    <span class="notification-time">
                                        Explore available tours
                                    </span>

                                </a>

                            </div>

                        </div>


                        <!-- Profile -->

                        <div class="dropdown">

                            <button class="profile-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <img class="avatar-img avatar-sm"
                                     src="@customerAvatar"
                                     alt="Traveler" />

                                <span class="profile-name d-none d-sm-inline">
                                    @customerName
                                </span>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Dashboard"
                                       asp-action="Index">

                                        <i class="bi bi-speedometer2 me-2"></i>
                                        Dashboard

                                    </a>

                                </li>


                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="MyBookings"
                                       asp-action="Index">

                                        <i class="bi bi-calendar-check me-2"></i>
                                        My Bookings

                                    </a>

                                </li>


                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Home"
                                       asp-action="Index">

                                        <i class="bi bi-house me-2"></i>
                                        Home

                                    </a>

                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <!-- LOGOUT -->

                                <li>

                                    @if (User.Identity?.IsAuthenticated ?? false)
                                    {
                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              asp-route-returnUrl="@Url.Action("Index", "Home")"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item">

                                                <i class="bi bi-box-arrow-right me-2"></i>

                                                Logout

                                            </button>

                                        </form>
                                    }

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </nav>


            <!-- ================= PAGE CONTENT ================= -->

            <main class="admin-content p-5">

                @RenderBody()

            </main>


            <!-- ================= FOOTER ================= -->

            <footer class="admin-footer">

                <div class="container-fluid px-3 px-lg-4">

                    <span>

                        Copyright 2026 Kernal Travel Guide.

                        <br />

                        Traveler Dashboard

                    </span>

                    <span>
                        Your journey starts here.
                    </span>

                </div>

            </footer>

        </div>

    </div>


    <!-- ================= SCRIPTS ================= -->

    <script src="@Url.Content("~/dashboard/assets/js/bootstrap.bundle.min.js")"></script>

    <script src="@Url.Content("~/dashboard/assets/js/main.js")"></script>

    @RenderSection("Scripts", required: false)

    <script>
        window.adminHMDUser = {
        name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(customerName)),
        workspace: "Traveler Account",
        avatar: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(customerAvatar))
        };
    </script>

</body>

</html>