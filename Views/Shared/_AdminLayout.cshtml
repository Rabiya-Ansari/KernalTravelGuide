@using Microsoft.AspNetCore.Identity
@using KernalTravelGuide.Data

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Kernal Travel Guide Admin</title>

    <link rel="stylesheet"
          href="@Url.Content("~/dashboard/assets/css/bootstrap.min.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/dashboard/assets/vendors/bootstrap-icons/bootstrap-icons.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/dashboard/assets/css/style.css")" />

    @RenderSection("Styles", required: false)
</head>

<body>

    <div class="admin-layout">

        <!-- ================= SIDEBAR ================= -->

        <aside class="admin-sidebar"
               id="adminSidebar"
               aria-label="Main navigation">

            <!-- Logo -->
            <div class="sidebar-header">

                <a class="brand-mark"
                   asp-controller="Admin"
                   asp-action="Index"
                   aria-label="Kernal Travel Guide Dashboard">

                    <span class="brand-icon">
                        <i class="bi bi-grid-1x2-fill"
                           aria-hidden="true"></i>
                    </span>

                    <span class="brand-copy">
                        <span class="brand-title">
                            Kernal Travel
                        </span>

                        <span class="brand-subtitle">
                            Admin Dashboard
                        </span>
                    </span>

                </a>

            </div>


            <!-- Navigation -->
            <nav class="sidebar-nav">

                <!-- Dashboard -->
                <a class="nav-link"
                   asp-controller="Admin"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-speedometer2"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Dashboard
                    </span>

                </a>


                <!-- Users -->
                <a class="nav-link"
                   asp-controller="Users"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-people"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Users
                    </span>

                </a>


                <!-- Countries -->
                <a class="nav-link"
                   asp-controller="Countries"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-globe"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Countries
                    </span>

                </a>


                <!-- Cities -->
                <a class="nav-link"
                   asp-controller="Cities"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-buildings"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Cities
                    </span>

                </a>


                <!-- Tourist Spots -->
                <a class="nav-link"
                   asp-controller="TouristSpots"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-geo-alt"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Tourist Spots
                    </span>

                </a>


                <!-- Hotels -->
                <a class="nav-link"
                   asp-controller="Hotels"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-building"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Hotels
                    </span>

                </a>


                <!-- Restaurants -->
                <a class="nav-link"
                   asp-controller="Restaurants"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-cup-hot"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Restaurants
                    </span>

                </a>


                <!-- Resorts -->
                <a class="nav-link"
                   asp-controller="Resorts"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-house-heart"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Resorts
                    </span>

                </a>


                <!-- Tour Packages -->
                <a class="nav-link"
                   asp-controller="TourPackages"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-map"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Tour Packages
                    </span>

                </a>


                <!-- Travel Information -->
                <a class="nav-link"
                   asp-controller="TravelInformations"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-info-circle"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Travel Information
                    </span>

                </a>


                <!-- Gallery -->
                <a class="nav-link"
                   asp-controller="Gallery"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-images"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Gallery
                    </span>

                </a>


                <!-- Bookings -->
                <a class="nav-link"
                   asp-controller="Bookings"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-calendar-check"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Bookings
                    </span>

                </a>


                <!-- Reviews -->
                <a class="nav-link"
                   asp-controller="Review"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-star"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Reviews
                    </span>

                </a>


                <!-- Feedbacks -->
                <a class="nav-link"
                   asp-controller="Feedbacks"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-chat-square-text"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Feedbacks
                    </span>

                </a>


                <!-- Contact Messages -->
                <a class="nav-link"
                   asp-controller="ContactMessages"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-envelope"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Contact Messages
                    </span>

                </a>


                <!-- Admin Bookings -->
                <a class="nav-link"
                   asp-controller="AdminBookings"
                   asp-action="Index">

                    <span class="nav-icon">
                        <i class="bi bi-journal-check"
                           aria-hidden="true"></i>
                    </span>

                    <span class="nav-text">
                        Manage Bookings
                    </span>

                </a>

            </nav>


            <!-- Sidebar User -->
            <div class="sidebar-user">

                <img class="avatar-img avatar-md sidebar-user-avatar"
                     src="@Url.Content("~/dashboard/assets/images/avatar/avatar.jpg")"
                     alt="Admin" />

                <strong>Admin</strong>

                <small>
                    Active Workspace
                </small>

            </div>


            <!-- Sidebar Footer -->
            <div class="sidebar-footer">

                <span class="status-dot"></span>

                <span class="sidebar-footer-text">
                    System running smoothly
                </span>

            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <div class="admin-main">


            <!-- ================= NAVBAR ================= -->

            <nav class="navbar admin-navbar navbar-expand bg-white">

                <div class="container-fluid px-3 px-lg-4">


                    <!-- Sidebar Toggle -->
                    <button class="sidebar-toggle"
                            type="button"
                            data-sidebar-toggle
                            aria-controls="adminSidebar"
                            aria-expanded="true"
                            aria-label="Toggle sidebar">

                        <span></span>
                        <span></span>
                        <span></span>

                    </button>


                    <!-- Search -->
                    <form class="d-none d-md-flex ms-3 flex-grow-1"
                          role="search">

                        <input class="form-control search-input"
                               type="search"
                               placeholder="Search users, bookings, reports"
                               aria-label="Search" />

                    </form>


                    <!-- Navbar Actions -->
                    <div class="navbar-actions ms-auto">


                        <!-- Theme -->
                        <button class="icon-button theme-toggle"
                                type="button"
                                data-theme-toggle
                                aria-label="Switch color theme"
                                title="Switch color theme">

                            <i class="bi bi-moon-stars"
                               data-theme-icon
                               aria-hidden="true"></i>

                        </button>


                        <!-- Notifications -->
                        <div class="dropdown">

                            <button class="icon-button"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Notifications">

                                <span class="notification-dot"></span>

                                <i class="bi bi-bell"
                                   aria-hidden="true"></i>

                            </button>


                            <div class="dropdown-menu dropdown-menu-end notification-menu">

                                <div class="dropdown-header fw-bold text-body">
                                    Notifications
                                </div>


                                <a class="dropdown-item"
                                   asp-controller="Bookings"
                                   asp-action="Index">

                                    <span class="notification-title">
                                        New booking
                                    </span>

                                    <span class="notification-time">
                                        View bookings
                                    </span>

                                </a>


                                <a class="dropdown-item"
                                   asp-controller="Users"
                                   asp-action="Index">

                                    <span class="notification-title">
                                        Users
                                    </span>

                                    <span class="notification-time">
                                        Manage users
                                    </span>

                                </a>


                                <a class="dropdown-item"
                                   asp-controller="ContactMessages"
                                   asp-action="Index">

                                    <span class="notification-title">
                                        Contact messages
                                    </span>

                                    <span class="notification-time">
                                        View messages
                                    </span>

                                </a>

                            </div>

                        </div>


                        <!-- Profile -->
                        <div class="dropdown">

                            <button class="profile-button dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <img class="avatar-img avatar-sm"
                                     src="@Url.Content("~/dashboard/assets/images/avatar/avatar.jpg")"
                                     alt="Admin" />

                                <span class="profile-name d-none d-sm-inline">
                                    Admin
                                </span>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Users"
                                       asp-action="Index">
                                        Users
                                    </a>
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <li>
                                    <a class="dropdown-item"
                                       asp-area="Identity"
                                       asp-page="/Account/Logout">
                                        Sign out
                                    </a>
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </nav>


            <!-- ================= PAGE CONTENT ================= -->

            <main class="admin-content">

                @RenderBody()

            </main>


            <!-- ================= FOOTER ================= -->

            <footer class="admin-footer">

                <div class="container-fluid px-3 px-lg-4">

                    <span>
                        Copyright 2026 Kernal Travel Guide.
                        <br />
                        Admin Dashboard
                    </span>

                    <span>
                        Professional Travel Management System.
                    </span>

                </div>

            </footer>

        </div>

    </div>


    <!-- ================= SCRIPTS ================= -->

    <script src="@Url.Content("~/dashboard/assets/js/bootstrap.bundle.min.js")"></script>

    <script src="@Url.Content("~/dashboard/assets/js/main.js")"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>