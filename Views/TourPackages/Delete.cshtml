@model KernalTravelGuide.Models.TourPackage

@{
    ViewData["Title"] = "Delete Tour Package";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Delete Tour Package</h1>

<div class="alert alert-danger">
    <strong>Are you sure?</strong>
    This tour package and its image will be permanently deleted.
</div>

<div class="card mb-4">

    <div class="card-body">

        <div class="row">

            <!-- Image -->
            <div class="col-md-4">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         alt="@Model.PackageName"
                         class="img-fluid rounded"
                         style="max-height:250px;
                    width:100%;
                    object-fit:cover;" />
                }
                else
                {
                    <div class="border rounded p-5 text-center">
                        No Image
                    </div>
                }

            </div>

            <!-- Details -->
            <div class="col-md-8">

                <h3>@Model.PackageName</h3>

                <hr />

                <dl class="row">

                    <dt class="col-sm-4">
                        Duration
                    </dt>

                    <dd class="col-sm-8">
                        @Model.DurationDays Days
                    </dd>

                    <dt class="col-sm-4">
                        Price
                    </dt>

                    <dd class="col-sm-8">
                        Rs. @Model.Price.ToString("N0")
                    </dd>

                    <dt class="col-sm-4">
                        Description
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-4">
                        Available
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.IsAvailable ? "Yes" : "No")
                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Yes, Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>