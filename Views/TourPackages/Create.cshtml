@model KernalTravelGuide.Models.TourPackage

@{
    ViewData["Title"] = "Create Tour Package";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Create Tour Package</h1>

<div class="row">

    <div class="col-md-7">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Package Name -->
            <div class="mb-3">

                <label asp-for="PackageName"
                       class="form-label">
                    Package Name
                </label>

                <input asp-for="PackageName"
                       class="form-control"
                       placeholder="Enter package name" />

                <span asp-validation-for="PackageName"
                      class="text-danger">
                </span>

            </div>

            <!-- Duration -->
            <div class="mb-3">

                <label asp-for="DurationDays"
                       class="form-label">
                    Duration (Days)
                </label>

                <input asp-for="DurationDays"
                       class="form-control"
                       type="number"
                       min="1"
                       max="30" />

                <span asp-validation-for="DurationDays"
                      class="text-danger">
                </span>

            </div>

            <!-- Price -->
            <div class="mb-3">

                <label asp-for="Price"
                       class="form-label">
                    Price
                </label>

                <input asp-for="Price"
                       class="form-control"
                       type="number"
                       min="1000"
                       max="500000"
                       step="0.01" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>

            </div>

            <!-- Description -->
            <div class="mb-3">

                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Enter package description">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>

            <!-- Image -->
            <div class="mb-3">

                <label class="form-label">
                    Package Image
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

                <small class="text-muted">
                    Select an image from your computer.
                </small>

            </div>

            <!-- Availability -->
            <div class="form-check mb-4">

                <input asp-for="IsAvailable"
                       class="form-check-input" />

                <label asp-for="IsAvailable"
                       class="form-check-label">
                    Available
                </label>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create Package
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}