@model KernalTravelGuide.Models.TourPackage

@{
    ViewData["Title"] = "Tour Package Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Tour Package Details</h1>

<div class="card">

    <div class="card-body">

        <div class="row">

            <!-- Image -->
            <div class="col-md-5 mb-4">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         alt="@Model.PackageName"
                         class="img-fluid rounded"
                         style="max-height:350px;
                    width:100%;
                    object-fit:cover;" />
                }
                else
                {
                    <div class="border rounded p-5 text-center">
                        <span class="text-muted">
                            No Image Available
                        </span>
                    </div>
                }

            </div>

            <!-- Information -->
            <div class="col-md-7">

                <h2>@Model.PackageName</h2>

                <hr />

                <dl class="row">

                    <dt class="col-sm-4">
                        Duration
                    </dt>

                    <dd class="col-sm-8">
                        @Model.DurationDays Days
                    </dd>


                    <dt class="col-sm-4">
                        Price
                    </dt>

                    <dd class="col-sm-8">
                        Rs. @Model.Price.ToString("N0")
                    </dd>


                    <dt class="col-sm-4">
                        Description
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Description
                    </dd>


                    <dt class="col-sm-4">
                        Availability
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success">
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Not Available
                            </span>
                        }

                    </dd>

                </dl>

                <div class="mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>