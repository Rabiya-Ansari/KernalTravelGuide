@model IEnumerable<KernalTravelGuide.Models.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Users</h1>
        <p class="text-muted mb-0">
            Manage registered customers and administrators.
        </p>
    </div>

    <span class="badge rounded-pill text-bg-light border px-3 py-2">
        <i class="bi bi-people me-1"></i>
        @Model.Count() Users
    </span>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white border-0 pt-4 px-4">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">
                    Registered Users
                </h5>

                <small class="text-muted">
                    Identity accounts registered in Karnel Travel Guide.
                </small>
            </div>

            <i class="bi bi-person-gear fs-4 text-primary"></i>

        </div>
    </div>

    <div class="card-body px-4 pb-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @user.FullName
                                    </strong>
                                </td>

                                <td>
                                    @(user.Email ?? "—")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "—"
                                        : user.PhoneNumber)
                                </td>

                                <td>
                                    @(user.UserName ?? "—")
                                </td>

                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge text-bg-danger">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">
                                            @user.Role
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye me-1"></i>
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil me-1"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-5">

                                <i class="bi bi-people fs-2 d-block mb-2"></i>

                                No users found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>