@model IEnumerable<KernalTravelGuide.Models.ContactMessage>

@{
    ViewData["Title"] = "Contact Messages";
}

<h1>Contact Messages</h1>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Subject</th>
            <th>Sent On</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                </td>

                <td>
                    @item.Email
                </td>

                <td>
                    @item.Phone
                </td>

                <td>
                    @item.Subject
                </td>

                <td>
                    @item.SentOn.ToString("dd MMM yyyy hh:mm tt")
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        View
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>