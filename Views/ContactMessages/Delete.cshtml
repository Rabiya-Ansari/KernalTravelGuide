@model KernalTravelGuide.Models.ContactMessage

@{
    ViewData["Title"] = "Delete Message";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Delete Message</h1>

<h3>Are you sure you want to delete this message?</h3>

<div class="card">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Name
            </dt>

            <dd class="col-sm-9">
                @Model.Name
            </dd>


            <dt class="col-sm-3">
                Email
            </dt>

            <dd class="col-sm-9">
                @Model.Email
            </dd>


            <dt class="col-sm-3">
                Subject
            </dt>

            <dd class="col-sm-9">
                @Model.Subject
            </dd>


            <dt class="col-sm-3">
                Message
            </dt>

            <dd class="col-sm-9">
                @Model.Message
            </dd>

        </dl>

    </div>

</div>

<br />

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>