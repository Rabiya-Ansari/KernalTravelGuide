@model KernalTravelGuide.Models.Booking

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Confirm Booking";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4">
                <h2 class="mb-3 fw-bold">Confirm Your Booking</h2>

                <!-- Dynamic Item Title Header -->
                @if (Model.TourPackage != null)
                {
                    <h5 class="text-primary mb-3">Package: <strong>@Model.TourPackage.PackageName</strong></h5>
                }
                else if (Model.TouristSpot != null)
                {
                    <h5 class="text-primary mb-3">Spot: <strong>@Model.TouristSpot.Name</strong></h5>
                }
                else if (Model.Hotel != null)
                {
                    <h5 class="text-primary mb-3">Hotel: <strong>@Model.Hotel.Name</strong></h5>
                }
                else if (Model.Resort != null)
                {
                    <h5 class="text-primary mb-3">Resort: <strong>@Model.Resort.Name</strong></h5>
                }
                else if (Model.Restaurant != null)
                {
                    <h5 class="text-primary mb-3">Restaurant: <strong>@Model.Restaurant.Name</strong></h5>
                }

                <form asp-action="Create" method="post" class="mt-2">
                    @Html.AntiForgeryToken()

                    <!-- Hidden Fields -->
                    <input type="hidden" asp-for="TourPackageId" />
                    <input type="hidden" asp-for="TouristSpotId" />
                    <input type="hidden" asp-for="HotelId" />
                    <input type="hidden" asp-for="ResortId" />
                    <input type="hidden" asp-for="RestaurantId" />

                    <div class="form-group mb-3">
                        <label asp-for="TravelDate" class="form-label fw-semibold">Travel / Visit Date</label>
                        <input asp-for="TravelDate" type="date" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NumberOfPersons" class="form-label fw-semibold">Number of Persons</label>
                        <input asp-for="NumberOfPersons" type="number" class="form-control" value="1" min="1" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3">Confirm & Book</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>