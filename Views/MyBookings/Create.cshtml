@model KernalTravelGuide.Models.TourPackage

@{
    ViewData["Title"] = "Book Tour Package";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-lg-5">

                    <!-- Header -->
                    <div class="mb-4">

                        <span class="text-primary fw-semibold">
                            Tour Booking
                        </span>

                        <h2 class="fw-bold mt-2">
                            @Model.PackageName
                        </h2>

                        <p class="text-muted mb-0">
                            @Model.Description
                        </p>

                    </div>


                    <!-- Package Information -->
                    <div class="row g-4 mb-4">

                        <div class="col-md-4">

                            <small class="text-muted d-block">
                                Duration
                            </small>

                            <strong>
                                @Model.DurationDays Days
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <small class="text-muted d-block">
                                Price per person
                            </small>

                            <strong>
                                Rs. @Model.Price.ToString("N0")
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <small class="text-muted d-block">
                                Availability
                            </small>

                            @if (Model.IsAvailable)
                            {
                                <strong class="text-success">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Available
                                </strong>
                            }
                            else
                            {
                                <strong class="text-danger">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Not Available
                                </strong>
                            }

                        </div>

                    </div>


                    @if (!Model.IsAvailable)
                    {
                        <div class="alert alert-danger">
                            This tour package is currently unavailable.
                        </div>
                    }
                    else
                    {
                        <!-- Booking Form -->

                        <form asp-controller="MyBookings"
                              asp-action="Create"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="tourPackageId"
                                   value="@Model.Id" />


                            <!-- Travel Date -->
                            <div class="mb-4">

                                <label for="travelDate"
                                       class="form-label fw-semibold">

                                    Travel Date

                                </label>

                                <input type="date"
                                       id="travelDate"
                                       name="travelDate"
                                       class="form-control"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />

                                <span class="text-danger">
                                    @Html.ValidationMessage("travelDate")
                                </span>

                            </div>


                            <!-- Number of Persons -->
                            <div class="mb-4">

                                <label for="numberOfPersons"
                                       class="form-label fw-semibold">

                                    Number of Persons

                                </label>

                                <input type="number"
                                       id="numberOfPersons"
                                       name="numberOfPersons"
                                       class="form-control"
                                       min="1"
                                       max="20"
                                       value="1"
                                       required />

                                <span class="text-danger">
                                    @Html.ValidationMessage("numberOfPersons")
                                </span>

                            </div>


                            <!-- Total -->
                            <div class="alert alert-light border">

                                <div class="d-flex justify-content-between align-items-center">

                                    <span class="fw-semibold">
                                        Estimated Total
                                    </span>

                                    <strong id="totalAmount"
                                            class="fs-5 text-primary">

                                        Rs. @Model.Price.ToString("N0")

                                    </strong>

                                </div>

                                <small class="text-muted">
                                    Final amount is calculated securely on the server.
                                </small>

                            </div>


                            <!-- Buttons -->
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-controller="TourPackages"
                                   asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Back

                                </a>


                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-calendar-check me-1"></i>
                                    Confirm Booking

                                </button>

                            </div>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const packagePrice = @Model.Price.ToString(
                            System.Globalization.CultureInfo.InvariantCulture);

        const personsInput =
            document.getElementById("numberOfPersons");

        const totalAmount =
            document.getElementById("totalAmount");


        if (personsInput && totalAmount) {

            personsInput.addEventListener("input", function() {

                let persons =
                    parseInt(personsInput.value) || 1;

                if (persons < 1)
                    persons = 1;

                if (persons > 20)
                    persons = 20;

                const total =
                    packagePrice * persons;

                totalAmount.textContent =
                    "Rs. " +
                    total.toLocaleString("en-PK", {
                        maximumFractionDigits: 0
                    });

            });

        }

    </script>

}