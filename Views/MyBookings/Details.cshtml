@model KernalTravelGuide.Models.Booking

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Booking Details";

    string itemName = "Booking";
    string itemType = "Travel Booking";
    string itemDescription = "";

    if (Model.TourPackage != null)
    {
        itemName = Model.TourPackage.PackageName;
        itemType = "Tour Package";
        itemDescription = Model.TourPackage.Description ?? "";
    }
    else if (Model.TouristSpot != null)
    {
        itemName = Model.TouristSpot.Name;
        itemType = "Tourist Spot";
        itemDescription = Model.TouristSpot.Description ?? "";
    }
    else if (Model.Hotel != null)
    {
        itemName = Model.Hotel.Name;
        itemType = "Hotel";
    }
    else if (Model.Resort != null)
    {
        itemName = Model.Resort.Name;
        itemType = "Resort";
    }
    else if (Model.Restaurant != null)
    {
        itemName = Model.Restaurant.Name;
        itemType = "Restaurant";
    }
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <span class="text-primary fw-semibold">
                                My Booking Details
                            </span>
                            <h2 class="fw-bold mt-2 mb-1">
                                @itemName
                            </h2>
                            <p class="text-muted mb-0">
                                Booking #@Model.Id
                            </p>
                        </div>

                        @{
                            var statusStr = Model.Status.ToString();
                        }

                        @if (statusStr == "Approved" || statusStr == "Confirmed")
                        {
                            <span class="badge bg-success px-3 py-2">@Model.Status</span>
                        }
                        else if (statusStr == "Rejected" || statusStr == "Cancelled")
                        {
                            <span class="badge bg-danger px-3 py-2">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">@Model.Status</span>
                        }
                    </div>

                    <!-- Item Information Card -->
                    <div class="border rounded p-4 mb-4 bg-light">
                        <h5 class="fw-bold mb-3 text-secondary">
                            @itemType Information
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Booked Item
                                </small>
                                <strong>
                                    @itemName
                                </strong>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Type
                                </small>
                                <strong>
                                    @itemType
                                </strong>
                            </div>

                            @if (!string.IsNullOrEmpty(itemDescription))
                            {
                                <div class="col-12">
                                    <small class="text-muted d-block">
                                        Description
                                    </small>
                                    <span>
                                        @itemDescription
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Booking Information Card -->
                    <div class="border rounded p-4 mb-4">
                        <h5 class="fw-bold mb-3 text-secondary">
                            Booking Summary
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Travel / Visit Date
                                </small>
                                <strong>
                                    @Model.TravelDate.ToString("dd MMM yyyy")
                                </strong>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Number of Persons
                                </small>
                                <strong>
                                    @Model.NumberOfPersons
                                </strong>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Booking Request Date
                                </small>
                                <strong>
                                    @Model.BookingDate.ToString("dd MMM yyyy hh:mm tt")
                                </strong>
                            </div>

                            <div class="col-md-6">
                                <small class="text-muted d-block">
                                    Total Amount
                                </small>
                                <strong class="text-primary fs-5">
                                    PKR @Model.TotalAmount.ToString("N0")
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- Status Message Box -->
                    <div class="alert alert-light border">
                        <strong>
                            Status Note:
                        </strong>

                        @if (statusStr == "Pending")
                        {
                            <span class="text-warning fw-semibold ms-2">
                                Your booking is waiting for administrator approval.
                            </span>
                        }
                        else if (statusStr == "Approved" || statusStr == "Confirmed")
                        {
                            <span class="text-success fw-semibold ms-2">
                                Your booking has been confirmed! Enjoy your journey.
                            </span>
                        }
                        else if (statusStr == "Rejected" || statusStr == "Cancelled")
                        {
                            <span class="text-danger fw-semibold ms-2">
                                This booking request was not approved.
                            </span>
                        }
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-4">
                        <a asp-controller="MyBookings"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to My Bookings
                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary">
                            Explore More
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>