@model KernalTravelGuide.Models.Resort

@{
    ViewData["Title"] = "Create Resort";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Create Resort</h1>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <!-- Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    Resort Name
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>

            <!-- City -->
            <div class="mb-3">
                <label asp-for="CityId" class="form-label">
                    City
                </label>

                <select asp-for="CityId"
                        asp-items="ViewBag.CityId"
                        class="form-control">

                    <option value="">
                        -- Select City --
                    </option>

                </select>

                <span asp-validation-for="CityId"
                      class="text-danger"></span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label asp-for="Price" class="form-label">
                    Price
                </label>

                <input asp-for="Price"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <!-- Rating -->
            <div class="mb-3">
                <label asp-for="Rating" class="form-label">
                    Rating
                </label>

                <input asp-for="Rating"
                       type="number"
                       min="1"
                       max="5"
                       class="form-control" />

                <span asp-validation-for="Rating"
                      class="text-danger"></span>
            </div>

            <!-- Availability -->
            <div class="form-check mb-3">

                <input asp-for="Availability"
                       class="form-check-input" />

                <label asp-for="Availability"
                       class="form-check-label">
                    Available
                </label>

            </div>

            <!-- IMAGE UPLOAD -->
            <div class="mb-3">

                <label class="form-label">
                    Resort Image
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

                <small class="text-muted">
                    Choose an image from your computer.
                </small>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create Resort
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}