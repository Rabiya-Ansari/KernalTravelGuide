@model KernalTravelGuide.Models.ViewModels.SearchViewModel

@{
    ViewData["Title"] = "Search";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Search</h1>
                    <p class="text-white">
                        Find tourist spots, hotels, restaurants and resorts.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Explore & Search</h1>
        <p class="text-muted">
            Find tourist spots, hotels, restaurants and resorts.
        </p>
    </div>


    <!-- Search Form -->

    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">

            <form asp-controller="Search"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Keyword -->

                    <div class="col-lg-4">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="keyword"
                               value="@Model.Keyword"
                               class="form-control"
                               placeholder="Search destination, hotel..." />

                    </div>


                    <!-- City -->

                    <div class="col-lg-3">

                        <label class="form-label fw-semibold">
                            Location
                        </label>

                        <select name="cityId"
                                class="form-select">

                            <option value="">
                                All Locations
                            </option>

                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city.Id"
                                        selected="@(Model.CityId == city.Id)">
                                    @city.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Minimum Price -->

                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            Min Price
                        </label>

                        <input type="number"
                               name="minPrice"
                               value="@Model.MinPrice"
                               class="form-control"
                               min="0"
                               placeholder="Min" />

                    </div>


                    <!-- Maximum Price -->

                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            Max Price
                        </label>

                        <input type="number"
                               name="maxPrice"
                               value="@Model.MaxPrice"
                               class="form-control"
                               min="0"
                               placeholder="Max" />

                    </div>


                    <!-- Search Button -->

                    <div class="col-lg-1 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-300">

                            <i class="bi bi-search"> Search</i>

                        </button>

                    </div>
                    <div class="mt-3">
                        <a asp-controller="Search"
                           asp-action="Advanced"
                           class="btn btn-primary w-300">
                            Advanced Search
                        </a>
                    </div>

                </div>

            </form>
            

        </div>
    </div>


    <!-- Tourist Spots -->

    <section class="mb-5">

        <h3 class="fw-bold mb-4">
            <i class="bi bi-geo-alt me-2"></i>
            Tourist Spots
        </h3>

        <div class="row g-4">

            @if (Model.TouristSpots.Any())
            {
                foreach (var item in Model.TouristSpots)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="card h-100 border-0 shadow-sm">

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     class="card-img-top"
                                     style="height:220px;object-fit:cover;"
                                     alt="@item.Name" />
                            }

                            <div class="card-body">

                                <h5 class="fw-bold">
                                    @item.Name
                                </h5>

                                <p class="text-muted mb-2">
                                    <i class="bi bi-geo-alt"></i>
                                    @item.City?.Name
                                </p>

                                <p>
                                    @item.Description
                                </p>

                                <strong>
                                    Entry Fee:
                                    Rs. @item.EntryFee.ToString("N0")
                                </strong>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted">
                        No tourist spots found.
                    </p>
                </div>
            }

        </div>

    </section>


    <!-- Hotels -->

    <section class="mb-5">

        <h3 class="fw-bold mb-4">
            <i class="bi bi-building me-2"></i>
            Hotels
        </h3>

        <div class="row g-4">

            @if (Model.Hotels.Any())
            {
                foreach (var item in Model.Hotels)
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="card h-100 border-0 shadow-sm">

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     class="card-img-top"
                                     style="height:200px;object-fit:cover;"
                                     alt="@item.Name" />
                            }

                            <div class="card-body">

                                <h5 class="fw-bold">
                                    @item.Name
                                </h5>

                                <p class="text-muted">
                                    @item.City?.Name
                                </p>

                                <div class="mb-2">
                                    @for (int i = 0; i < item.StarRating; i++)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                </div>

                                <strong>
                                    Rs. @item.PricePerNight.ToString("N0")
                                    / night
                                </strong>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted">
                        No hotels found.
                    </p>
                </div>
            }

        </div>

    </section>


    <!-- Restaurants -->

    <section class="mb-5">

        <h3 class="fw-bold mb-4">
            <i class="bi bi-cup-hot me-2"></i>
            Restaurants
        </h3>

        <div class="row g-4">

            @if (Model.Restaurants.Any())
            {
                foreach (var item in Model.Restaurants)
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="card h-100 border-0 shadow-sm">

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     class="card-img-top"
                                     style="height:200px;object-fit:cover;"
                                     alt="@item.Name" />
                            }

                            <div class="card-body">

                                <h5 class="fw-bold">
                                    @item.Name
                                </h5>

                                <p class="text-muted">
                                    @item.City?.Name
                                </p>

                                <div>

                                    @for (int i = 0; i < (int)item.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted">
                        No restaurants found.
                    </p>
                </div>
            }

        </div>

    </section>


    <!-- Resorts -->

    <section>

        <h3 class="fw-bold mb-4">
            <i class="bi bi-house-heart me-2"></i>
            Resorts
        </h3>

        <div class="row g-4">

            @if (Model.Resorts.Any())
            {
                foreach (var item in Model.Resorts)
                {
                    <div class="col-md-6 col-lg-3">

                        <div class="card h-100 border-0 shadow-sm">

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     class="card-img-top"
                                     style="height:200px;object-fit:cover;"
                                     alt="@item.Name" />
                            }

                            <div class="card-body">

                                <h5 class="fw-bold">
                                    @item.Name
                                </h5>

                                <p class="text-muted">
                                    @item.City?.Name
                                </p>

                                <div>

                                    @for (int i = 0; i < item.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }

                                </div>

                                <strong>
                                    Rs. @item.Price.ToString("N0")
                                </strong>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted">
                        No resorts found.
                    </p>
                </div>
            }

        </div>

    </section>

</div>