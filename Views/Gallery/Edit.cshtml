@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Edit Gallery Image";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Edit Gallery Image</h1>

<div class="row">

    <div class="col-md-7">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden"
                   asp-for="Id" />

            <!-- Current Image -->
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-4">

                    <label class="form-label">
                        Current Image
                    </label>

                    <div>
                        <img src="@Model.ImagePath"
                             alt="@Model.Caption"
                             style="width:250px;
                        height:170px;
                        object-fit:cover;
                        border-radius:10px;" />
                    </div>

                </div>
            }

            <!-- New Image -->

            <div class="mb-3">

                <label class="form-label">
                    Change Image
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*" />

                <small class="text-muted">
                    Leave empty if you want to keep the current image.
                </small>

            </div>

            <!-- Caption -->

            <div class="mb-3">

                <label asp-for="Caption"
                       class="form-label">
                    Caption
                </label>

                <input asp-for="Caption"
                       class="form-control"
                       placeholder="Enter image caption" />

                <span asp-validation-for="Caption"
                      class="text-danger">
                </span>

            </div>

            <!-- Tourist Spot -->

            <div class="mb-3">

                <label asp-for="TouristSpotId"
                       class="form-label">
                    Tourist Spot
                </label>

                <select asp-for="TouristSpotId"
                        class="form-select">

                    <option value="">
                        -- Select Tourist Spot --
                    </option>

                    @foreach (var item in ViewBag.TouristSpots)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- Hotel -->

            <div class="mb-3">

                <label asp-for="HotelId"
                       class="form-label">
                    Hotel
                </label>

                <select asp-for="HotelId"
                        class="form-select">

                    <option value="">
                        -- Select Hotel --
                    </option>

                    @foreach (var item in ViewBag.Hotels)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- Restaurant -->

            <div class="mb-3">

                <label asp-for="RestaurantId"
                       class="form-label">
                    Restaurant
                </label>

                <select asp-for="RestaurantId"
                        class="form-select">

                    <option value="">
                        -- Select Restaurant --
                    </option>

                    @foreach (var item in ViewBag.Restaurants)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- Resort -->

            <div class="mb-3">

                <label asp-for="ResortId"
                       class="form-label">
                    Resort
                </label>

                <select asp-for="ResortId"
                        class="form-select">

                    <option value="">
                        -- Select Resort --
                    </option>

                    @foreach (var item in ViewBag.Resorts)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- Tour Package -->

            <div class="mb-4">

                <label asp-for="TourPackageId"
                       class="form-label">
                    Tour Package
                </label>

                <select asp-for="TourPackageId"
                        class="form-select">

                    <option value="">
                        -- Select Tour Package --
                    </option>

                    @foreach (var item in ViewBag.TourPackages)
                    {
                        <option value="@item.Id">
                            @item.PackageName
                        </option>
                    }

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}