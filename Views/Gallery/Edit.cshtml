@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Edit Gallery Image";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Edit Gallery Image</h2>
            <p class="text-muted">
                Update image or gallery information.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       asp-for="ImagePath" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- CURRENT IMAGE -->

                <div class="mb-4">

                    <label class="form-label">
                        Current Image
                    </label>

                    <br />

                    <img src="@Model.ImagePath"
                         alt="@Model.Caption"
                         style="width:220px;
                    height:150px;
                    object-fit:cover;
                    border-radius:10px;" />

                </div>


                <!-- NEW IMAGE -->

                <div class="mb-4">

                    <label class="form-label">
                        Replace Image
                    </label>

                    <input type="file"
                           name="ImageFile"
                           class="form-control"
                           accept="image/*" />

                    <small class="text-muted">
                        Leave empty if you want to keep the current image.
                    </small>

                </div>


                <!-- CAPTION -->

                <div class="mb-4">

                    <label asp-for="Caption"
                           class="form-label">
                        Caption
                    </label>

                    <input asp-for="Caption"
                           class="form-control" />

                    <span asp-validation-for="Caption"
                          class="text-danger">
                    </span>

                </div>


                <div class="row">


                    <!-- TOURIST SPOT -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="TouristSpotId"
                               class="form-label">
                            Tourist Spot
                        </label>

                        <select asp-for="TouristSpotId"
                                class="form-select">

                            <option value="">
                                -- Select Tourist Spot --
                            </option>

                            @foreach (var item in ViewBag.TouristSpots)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- HOTEL -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="HotelId"
                               class="form-label">
                            Hotel
                        </label>

                        <select asp-for="HotelId"
                                class="form-select">

                            <option value="">
                                -- Select Hotel --
                            </option>

                            @foreach (var item in ViewBag.Hotels)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- RESTAURANT -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="RestaurantId"
                               class="form-label">
                            Restaurant
                        </label>

                        <select asp-for="RestaurantId"
                                class="form-select">

                            <option value="">
                                -- Select Restaurant --
                            </option>

                            @foreach (var item in ViewBag.Restaurants)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- RESORT -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="ResortId"
                               class="form-label">
                            Resort
                        </label>

                        <select asp-for="ResortId"
                                class="form-select">

                            <option value="">
                                -- Select Resort --
                            </option>

                            @foreach (var item in ViewBag.Resorts)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- TOUR PACKAGE -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="TourPackageId"
                               class="form-label">
                            Tour Package
                        </label>

                        <select asp-for="TourPackageId"
                                class="form-select">

                            <option value="">
                                -- Select Tour Package --
                            </option>

                            @foreach (var item in ViewBag.TourPackages)
                            {
                                <option value="@item.Id">
                                    @item.PackageName
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Update Gallery

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}