@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Delete Gallery Image";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Delete Gallery Image</h1>

<div class="alert alert-danger">
    <strong>Are you sure?</strong>
    This gallery image will be permanently deleted.
</div>

<div class="card mb-4">

    <div class="card-body">

        <div class="row">

            <!-- Image -->

            <div class="col-md-5">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         alt="@Model.Caption"
                         style="width:100%;
                    max-height:300px;
                    object-fit:cover;
                    border-radius:12px;" />
                }
                else
                {
                    <div class="border rounded p-5 text-center">
                        No Image
                    </div>
                }

            </div>

            <!-- Information -->

            <div class="col-md-7">

                <h3>
                    @(Model.Caption ?? "Gallery Image")
                </h3>

                <hr />

                <dl class="row">

                    <dt class="col-sm-5">
                        Caption
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Caption ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Tourist Spot
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.TouristSpot?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Hotel
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Hotel?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Restaurant
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Restaurant?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Resort
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Resort?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Tour Package
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.TourPackage?.PackageName ?? "-")
                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Yes, Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>