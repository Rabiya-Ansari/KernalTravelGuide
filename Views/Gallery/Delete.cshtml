@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Delete Gallery Image";
}

<h1>Delete Gallery Image</h1>

<h3>Are you sure you want to delete this image?</h3>

<div>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Image Path
        </dt>

        <dd class="col-sm-9">
            @Model.ImagePath
        </dd>

        <dt class="col-sm-3">
            Caption
        </dt>

        <dd class="col-sm-9">
            @(Model.Caption ?? "-")
        </dd>

        <dt class="col-sm-3">
            Tourist Spot
        </dt>

        <dd class="col-sm-9">
            @(Model.TouristSpot?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Hotel
        </dt>

        <dd class="col-sm-9">
            @(Model.Hotel?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Restaurant
        </dt>

        <dd class="col-sm-9">
            @(Model.Restaurant?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Resort
        </dt>

        <dd class="col-sm-9">
            @(Model.Resort?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Tour Package
        </dt>

        <dd class="col-sm-9">
            @(Model.TourPackage?.PackageName ?? "-")
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>