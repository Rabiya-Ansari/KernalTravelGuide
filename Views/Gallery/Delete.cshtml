@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Delete Gallery Image";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Delete Gallery Image</h2>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="alert alert-danger">

                <strong>Are you sure?</strong>

                This image will be permanently deleted.

            </div>


            <div class="row align-items-center">


                <div class="col-md-4 text-center">

                    <img src="@Model.ImagePath"
                         alt="@Model.Caption"
                         class="img-fluid rounded"
                         style="max-height:250px;" />

                </div>


                <div class="col-md-8">

                    <h4>
                        @Model.Caption
                    </h4>

                    <p>
                        <strong>Image:</strong>
                        @Model.ImagePath
                    </p>

                    @if (Model.TouristSpot != null)
                    {
                        <p>
                            <strong>Tourist Spot:</strong>
                            @Model.TouristSpot.Name
                        </p>
                    }

                    @if (Model.Hotel != null)
                    {
                        <p>
                            <strong>Hotel:</strong>
                            @Model.Hotel.Name
                        </p>
                    }

                    @if (Model.Restaurant != null)
                    {
                        <p>
                            <strong>Restaurant:</strong>
                            @Model.Restaurant.Name
                        </p>
                    }

                    @if (Model.Resort != null)
                    {
                        <p>
                            <strong>Resort:</strong>
                            @Model.Resort.Name
                        </p>
                    }

                    @if (Model.TourPackage != null)
                    {
                        <p>
                            <strong>Tour Package:</strong>
                            @Model.TourPackage.PackageName
                        </p>
                    }


                    <form asp-action="Delete"
                          method="post"
                          class="mt-4">

                        <input type="hidden"
                               asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash"></i>
                            Yes, Delete

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>