@model IEnumerable<KernalTravelGuide.Models.Gallery>

@{
    ViewData["Title"] = "Gallery";
}

<h1>Gallery</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add New Image
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Image</th>
            <th>Caption</th>
            <th>Tourist Spot</th>
            <th>Hotel</th>
            <th>Restaurant</th>
            <th>Resort</th>
            <th>Tour Package</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.ImagePath
                </td>

                <td>
                    @item.Caption
                </td>

                <td>
                    @(item.TouristSpot?.Name ?? "-")
                </td>

                <td>
                    @(item.Hotel?.Name ?? "-")
                </td>

                <td>
                    @(item.Restaurant?.Name ?? "-")
                </td>

                <td>
                    @(item.Resort?.Name ?? "-")
                </td>

                <td>
                    @(item.TourPackage?.PackageName ?? "-")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>
</table>