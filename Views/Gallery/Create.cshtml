@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Add Gallery Image";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Add Gallery Image</h1>

<div class="row">
    <div class="col-md-7">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <!-- IMAGE -->
            <div class="mb-3">

                <label class="form-label">
                    Select Image
                </label>

                <input type="file"
                       name="ImageFile"
                       class="form-control"
                       accept="image/*"
                       required />

                <span asp-validation-for="ImagePath"
                      class="text-danger"></span>

                <small class="text-muted">
                    Select image from your computer.
                </small>

            </div>

            <!-- CAPTION -->
            <div class="mb-3">

                <label asp-for="Caption"
                       class="form-label">
                    Caption
                </label>

                <input asp-for="Caption"
                       class="form-control"
                       placeholder="Beautiful mountain view" />

                <span asp-validation-for="Caption"
                      class="text-danger"></span>

            </div>

            <!-- TOURIST SPOT -->
            <div class="mb-3">

                <label asp-for="TouristSpotId"
                       class="form-label">
                    Tourist Spot
                </label>

                <select asp-for="TouristSpotId"
                        class="form-select">

                    <option value="">
                        -- Select Tourist Spot --
                    </option>

                    @foreach (var item in ViewBag.TouristSpots)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- HOTEL -->
            <div class="mb-3">

                <label asp-for="HotelId"
                       class="form-label">
                    Hotel
                </label>

                <select asp-for="HotelId"
                        class="form-select">

                    <option value="">
                        -- Select Hotel --
                    </option>

                    @foreach (var item in ViewBag.Hotels)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- RESTAURANT -->
            <div class="mb-3">

                <label asp-for="RestaurantId"
                       class="form-label">
                    Restaurant
                </label>

                <select asp-for="RestaurantId"
                        class="form-select">

                    <option value="">
                        -- Select Restaurant --
                    </option>

                    @foreach (var item in ViewBag.Restaurants)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- RESORT -->
            <div class="mb-3">

                <label asp-for="ResortId"
                       class="form-label">
                    Resort
                </label>

                <select asp-for="ResortId"
                        class="form-select">

                    <option value="">
                        -- Select Resort --
                    </option>

                    @foreach (var item in ViewBag.Resorts)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }

                </select>

            </div>

            <!-- TOUR PACKAGE -->
            <div class="mb-4">

                <label asp-for="TourPackageId"
                       class="form-label">
                    Tour Package
                </label>

                <select asp-for="TourPackageId"
                        class="form-select">

                    <option value="">
                        -- Select Tour Package --
                    </option>

                    @foreach (var item in ViewBag.TourPackages)
                    {
                        <option value="@item.Id">
                            @item.PackageName
                        </option>
                    }

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save Image
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}