@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Add Gallery Image";
}

<h1>Add Gallery Image</h1>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ImagePath" class="control-label">
                    Image Path
                </label>

                <input asp-for="ImagePath"
                       class="form-control"
                       placeholder="images/gallery/image.jpg" />

                <span asp-validation-for="ImagePath"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Caption" class="control-label">
                    Caption
                </label>

                <input asp-for="Caption"
                       class="form-control"
                       placeholder="Beautiful mountain view" />

                <span asp-validation-for="Caption"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TouristSpotId" class="control-label">
                    Tourist Spot
                </label>

                <select asp-for="TouristSpotId"
                        class="form-control">
                    <option value="">-- Select Tourist Spot --</option>

                    @foreach (var item in ViewBag.TouristSpots)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HotelId" class="control-label">
                    Hotel
                </label>

                <select asp-for="HotelId"
                        class="form-control">
                    <option value="">-- Select Hotel --</option>

                    @foreach (var item in ViewBag.Hotels)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RestaurantId" class="control-label">
                    Restaurant
                </label>

                <select asp-for="RestaurantId"
                        class="form-control">
                    <option value="">-- Select Restaurant --</option>

                    @foreach (var item in ViewBag.Restaurants)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ResortId" class="control-label">
                    Resort
                </label>

                <select asp-for="ResortId"
                        class="form-control">
                    <option value="">-- Select Resort --</option>

                    @foreach (var item in ViewBag.Resorts)
                    {
                        <option value="@item.Id">
                            @item.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourPackageId" class="control-label">
                    Tour Package
                </label>

                <select asp-for="TourPackageId"
                        class="form-control">
                    <option value="">-- Select Tour Package --</option>

                    @foreach (var item in ViewBag.TourPackages)
                    {
                        <option value="@item.Id">
                            @item.PackageName
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Image
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}