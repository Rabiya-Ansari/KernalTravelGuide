@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Gallery Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mb-4">Gallery Details</h1>

<div class="card">

    <div class="card-body">

        <div class="row">

            <!-- Image -->

            <div class="col-md-5 mb-4">

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         alt="@Model.Caption"
                         style="width:100%;
                    max-height:350px;
                    object-fit:cover;
                    border-radius:12px;" />
                }
                else
                {
                    <div class="border rounded p-5 text-center">
                        No Image Available
                    </div>
                }

            </div>

            <!-- Details -->

            <div class="col-md-7">

                <h2>
                    @(string.IsNullOrEmpty(Model.Caption)
                        ? "Gallery Image"
                        : Model.Caption)
                </h2>

                <hr />

                <dl class="row">

                    <dt class="col-sm-5">
                        Caption
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Caption ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Tourist Spot
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.TouristSpot?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Hotel
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Hotel?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Restaurant
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Restaurant?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Resort
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.Resort?.Name ?? "-")
                    </dd>

                    <dt class="col-sm-5">
                        Tour Package
                    </dt>

                    <dd class="col-sm-7">
                        @(Model.TourPackage?.PackageName ?? "-")
                    </dd>

                </dl>

                <div class="mt-4">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>