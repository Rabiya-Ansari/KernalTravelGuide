@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Gallery Details";
}

<h1>Gallery Details</h1>

<div>

    <h4>Gallery Image</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Image Path
        </dt>

        <dd class="col-sm-9">
            @Model.ImagePath
        </dd>

        <dt class="col-sm-3">
            Caption
        </dt>

        <dd class="col-sm-9">
            @(Model.Caption ?? "-")
        </dd>

        <dt class="col-sm-3">
            Tourist Spot
        </dt>

        <dd class="col-sm-9">
            @(Model.TouristSpot?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Hotel
        </dt>

        <dd class="col-sm-9">
            @(Model.Hotel?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Restaurant
        </dt>

        <dd class="col-sm-9">
            @(Model.Restaurant?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Resort
        </dt>

        <dd class="col-sm-9">
            @(Model.Resort?.Name ?? "-")
        </dd>

        <dt class="col-sm-3">
            Tour Package
        </dt>

        <dd class="col-sm-9">
            @(Model.TourPackage?.PackageName ?? "-")
        </dd>

    </dl>

</div>

<div>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Gallery
    </a>

</div>