@model KernalTravelGuide.Models.Gallery

@{
    ViewData["Title"] = "Gallery Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Gallery Details</h2>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">


                <!-- IMAGE -->

                <div class="col-md-5 text-center">

                    <img src="@Model.ImagePath"
                         alt="@Model.Caption"
                         class="img-fluid rounded shadow-sm"
                         style="max-height:400px;
                    object-fit:cover;" />

                </div>


                <!-- INFORMATION -->

                <div class="col-md-7">

                    <h4 class="mb-4">
                        @Model.Caption
                    </h4>


                    <dl class="row">

                        <dt class="col-sm-4">
                            Image Path
                        </dt>

                        <dd class="col-sm-8">
                            @Model.ImagePath
                        </dd>


                        <dt class="col-sm-4">
                            Tourist Spot
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.TouristSpot?.Name ?? "Not assigned")
                        </dd>


                        <dt class="col-sm-4">
                            Hotel
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.Hotel?.Name ?? "Not assigned")
                        </dd>


                        <dt class="col-sm-4">
                            Restaurant
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.Restaurant?.Name ?? "Not assigned")
                        </dd>


                        <dt class="col-sm-4">
                            Resort
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.Resort?.Name ?? "Not assigned")
                        </dd>


                        <dt class="col-sm-4">
                            Tour Package
                        </dt>

                        <dd class="col-sm-8">
                            @(Model.TourPackage?.PackageName ?? "Not assigned")
                        </dd>

                    </dl>


                    <div class="mt-4">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">

                            <i class="bi bi-pencil"></i>
                            Edit

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-danger">

                            <i class="bi bi-trash"></i>
                            Delete

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>