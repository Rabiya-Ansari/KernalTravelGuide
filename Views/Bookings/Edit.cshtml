@model KernalTravelGuide.Models.Booking

@{
    ViewData["Title"] = "Update Booking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>
        <h1 class="mb-1">
            Update Booking
        </h1>

        <p class="text-muted mb-0">
            Update the status of booking #@Model.Id.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to Bookings

    </a>

</div>


<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <div class="mb-4">

                    <h5>
                        Booking #@Model.Id
                    </h5>

                    <p class="text-muted mb-0">
                        Change the booking status below.
                    </p>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Customer
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(Model.User != null
                                                          ? $"{Model.User.FirstName} {Model.User.LastName}"
                                                          : "Unknown User")"
                           readonly />

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        Tour Package
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(Model.TourPackage?.PackageName ?? "Unknown Package")"
                           readonly />

                </div>


                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Travel Date
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.TravelDate.ToString("dd MMMM yyyy")"
                               readonly />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Number of Persons
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.NumberOfPersons"
                               readonly />

                    </div>

                </div>


                <div class="mt-3 mb-4">

                    <label class="form-label">
                        Total Amount
                    </label>

                    <input type="text"
                           class="form-control"
                           value="Rs. @Model.TotalAmount.ToString("N0")"
                           readonly />

                </div>


                <form asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="Id"
                           type="hidden" />

                    <div class="mb-4">

                        <label asp-for="Status"
                               class="form-label fw-semibold">

                            Booking Status

                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            @foreach (var status in
                                Enum.GetValues<KernalTravelGuide.Models.Enums.BookingStatus>())
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-light border">

                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check2-circle me-1"></i>
                            Update Status

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}