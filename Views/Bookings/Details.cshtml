@model KernalTravelGuide.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                User
            </dt>
            <dd class="col-sm-9">
                @(Model.User?.UserName ?? Model.UserId)
            </dd>

            <dt class="col-sm-3">
                Tour Package
            </dt>
            <dd class="col-sm-9">
                @(Model.TourPackage?.PackageName ?? "N/A")
            </dd>

            <dt class="col-sm-3">
                Travel Date
            </dt>
            <dd class="col-sm-9">
                @Model.TravelDate.ToString("dd-MM-yyyy")
            </dd>

            <dt class="col-sm-3">
                Number of Persons
            </dt>
            <dd class="col-sm-9">
                @Model.NumberOfPersons
            </dd>

            <dt class="col-sm-3">
                Total Amount
            </dt>
            <dd class="col-sm-9">
                @Model.TotalAmount
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Booking Date
            </dt>
            <dd class="col-sm-9">
                @Model.BookingDate.ToString("dd-MM-yyyy")
            </dd>

        </dl>

    </div>
</div>

<br />

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Change Status
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back to List
</a>