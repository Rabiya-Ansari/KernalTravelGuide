@model IEnumerable<KernalTravelGuide.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Bookings</h1>
        <p class="text-muted mb-0">
            Manage customer tour bookings
        </p>
    </div>
</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>User</th>
                        <th>Tour Package</th>
                        <th>Travel Date</th>
                        <th>Persons</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>#@item.Id</strong>
                                </td>

                                <td>
                                    @if (item.User != null)
                                    {
                                        <div>
                                            <strong>
                                                @item.User.FirstName @item.User.LastName
                                            </strong>
                                        </div>

                                        <small class="text-muted">
                                            @item.User.Email
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unknown User
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.TourPackage?.PackageName
                                </td>

                                <td>
                                    @item.TravelDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.NumberOfPersons
                                </td>

                                <td>
                                    <strong>
                                        Rs. @item.TotalAmount.ToString("N0")
                                    </strong>
                                </td>

                                <td>
                                    @switch (item.Status.ToString())
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                            break;

                                        case "Confirmed":
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                            break;

                                        case "Cancelled":
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @item.BookingDate.ToString("dd MMM yyyy")
                                    <br />
                                    <small class="text-muted">
                                        @item.BookingDate.ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center py-5">

                                <i class="bi bi-calendar-x fs-1 text-muted"></i>

                                <h5 class="mt-3">
                                    No bookings found
                                </h5>

                                <p class="text-muted">
                                    There are currently no bookings.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>