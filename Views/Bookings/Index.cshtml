@model IEnumerable<KernalTravelGuide.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>
        <h1 class="mb-1">
            Bookings
        </h1>

        <p class="text-muted mb-0">
            Manage customer tour bookings.
        </p>
    </div>

    <span class="badge rounded-pill text-bg-light border px-3 py-2">
        <i class="bi bi-calendar-check me-1"></i>
        @Model.Count() Bookings
    </span>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="card shadow-sm border-0">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h5 class="mb-1">
                    Customer Bookings
                </h5>

                <small class="text-muted">
                    Review and manage customer tour reservations.
                </small>
            </div>

            <i class="bi bi-calendar2-check fs-4 text-primary"></i>

        </div>

    </div>


    <div class="card-body px-4 pb-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>#</th>
                        <th>Customer</th>
                        <th>Tour Package</th>
                        <th>Travel Date</th>
                        <th>Persons</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Booking Date</th>
                        <th class="text-end">Actions</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        #@item.Id
                                    </strong>
                                </td>


                                <td>

                                    @if (item.User != null)
                                    {
                                        <div class="fw-semibold">
                                            @item.User.FirstName
                                            @item.User.LastName
                                        </div>

                                        <small class="text-muted">
                                            @item.User.Email
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unknown User
                                        </span>
                                    }

                                </td>


                                <td>
                                    @(item.TourPackage?.PackageName ?? "Unknown Package")
                                </td>


                                <td>
                                    @item.TravelDate.ToString("dd MMM yyyy")
                                </td>


                                <td>
                                    @item.NumberOfPersons
                                </td>


                                <td>
                                    <strong>
                                        Rs. @item.TotalAmount.ToString("N0")
                                    </strong>
                                </td>


                                <td>

                                    @switch (item.Status)
                                    {
                                        case KernalTravelGuide.Models.Enums.BookingStatus.Pending:

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                            break;


                                        case KernalTravelGuide.Models.Enums.BookingStatus.Confirmed:

                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>

                                            break;


                                        case KernalTravelGuide.Models.Enums.BookingStatus.Cancelled:

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;


                                        case KernalTravelGuide.Models.Enums.BookingStatus.Completed:

                                            <span class="badge bg-primary">
                                                Completed
                                            </span>

                                            break;


                                        default:

                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>

                                            break;
                                    }

                                </td>


                                <td>

                                    @item.BookingDate.ToString("dd MMM yyyy")

                                    <br />

                                    <small class="text-muted">
                                        @item.BookingDate.ToString("hh:mm tt")
                                    </small>

                                </td>


                                <td class="text-end">

                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Update Status">

                                            <i class="bi bi-pencil"></i>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete Booking">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center py-5">

                                <i class="bi bi-calendar-x fs-1 text-muted"></i>

                                <h5 class="mt-3">
                                    No bookings found
                                </h5>

                                <p class="text-muted mb-0">
                                    There are currently no customer bookings.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>