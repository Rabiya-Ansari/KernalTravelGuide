@model IEnumerable<KernalTravelGuide.Models.TravelInformation>

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Travel Information & Routes";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Travel Information & Routes</h1>
                    <p class="text-white">
                        Find transport details, routes, and fare information for your travel across Pakistan.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="untree_co-section">
    <div class="container">

        <!-- Section Heading -->
        <div class="row text-center justify-content-center mb-5">
            <div class="col-lg-7">
                <h2 class="section-title text-center">Travel Routes & Fares</h2>
                <p class="text-muted">
                    Find transport details, routes, and fare information for your travel across Pakistan.
                </p>
            </div>
        </div>

        <!-- Travel Cards / Table List -->
        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var info in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm border-0 rounded-lg">
                            <div class="card-body d-flex flex-column">

                                <!-- Transport Name & Fare -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="card-title text-primary font-weight-bold mb-0">
                                        @info.TransportName
                                    </h5>
                                    <span class="badge badge-success p-2 font-weight-normal">
                                        PKR @info.Fare
                                    </span>
                                </div>

                                <!-- Route Info -->
                                <div class="mb-3 bg-light p-3 rounded">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-muted d-block">From</small>
                                            <strong>@(info.FromCity?.Name ?? "N/A")</strong>
                                        </div>
                                        <div>
                                            <i class="icon-long-arrow-right text-primary h4 mb-0"></i>
                                        </div>
                                        <div class="text-right">
                                            <small class="text-muted d-block">To</small>
                                            <strong>@(info.ToCity?.Name ?? "N/A")</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- Description -->
                                <p class="card-text text-muted flex-grow-1">
                                    @if (!string.IsNullOrEmpty(info.Description))
                                    {
                                        @(info.Description.Length > 90
                                            ? info.Description.Substring(0, 90) + "..."
                                            : info.Description)
                                    }
                                    else
                                    {
                                        <span>No additional transport details provided.</span>
                                    }
                                </p>

                                <!-- Details Button -->
                                <a asp-controller="PublicTravelInformation"
                                   asp-action="Details"
                                   asp-route-id="@info.Id"
                                   class="btn btn-outline-primary btn-block mt-auto">
                                    View Full Details
                                </a>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="col-12 text-center py-5">
                    <i class="icon-info-circle display-4 text-muted"></i>
                    <h4 class="mt-3">No Travel Information Available</h4>
                    <p class="text-muted">Transport routes and fare details will be updated soon.</p>
                </div>
            }
        </div>

    </div>
</div>