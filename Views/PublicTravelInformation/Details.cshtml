@model KernalTravelGuide.Models.TravelInformation

@{
    Layout = "_ClientLayout";
    ViewData["Title"] = "Route Details";
}
<div class="hero hero-inner">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mx-auto text-center">
                <div class="intro-wrap">
                    <h1 class="mb-0">Route Details</h1>
                    <p class="text-white">
                        Discover detailed information about your selected travel route.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="untree_co-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 p-4">

                    <h2 class="text-primary mb-3">@Model.TransportName</h2>
                    <hr />

                    <div class="row my-4 text-center">
                        <div class="col-md-5 bg-light p-3 rounded">
                            <h6 class="text-muted">Departure City</h6>
                            <h4>@(Model.FromCity?.Name ?? "N/A")</h4>
                        </div>
                        <div class="col-md-2 d-flex align-items-center justify-content-center my-2 my-md-0">
                            <i class="icon-arrow-right display-4 text-primary"></i>
                        </div>
                        <div class="col-md-5 bg-light p-3 rounded">
                            <h6 class="text-muted">Destination City</h6>
                            <h4>@(Model.ToCity?.Name ?? "N/A")</h4>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h5 class="font-weight-bold">Ticket Fare:</h5>
                        <p class="h4 text-success">PKR @Model.Fare</p>
                    </div>

                    <div class="mb-4">
                        <h5 class="font-weight-bold">Additional Details:</h5>
                        <p class="text-muted">
                            @(string.IsNullOrEmpty(Model.Description) ? "No extra information available for this route." : Model.Description)
                        </p>
                    </div>

                    <!-- Actions (Resort/Hotel Style Buttons) -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            Back to List
                        </a>

                        <div class="d-flex gap-2">
                            @if (User.IsInRole("Customer"))
                            {
                                <a asp-controller="Feedback"
                                   asp-action="Create"
                                   asp-route-travelInfoId="@Model.Id"
                                   class="btn btn-outline-primary me-2">
                                    <i class="fa fa-star"></i> Give Your Review
                                </a>
                            }

                            <a asp-controller="PublicTravelInformation"
                               asp-action="BookNow"
                               asp-route-travelInfoId="@Model.Id"
                               class="btn btn-primary btn-lg">
                                Book Ticket Now
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>