@model IEnumerable<KernalTravelGuide.Models.TravelInformation>

@{
    ViewData["Title"] = "Travel Information";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Travel Information</h1>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Add Travel Information
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Transport</th>
            <th>From City</th>
            <th>To City</th>
            <th>Fare</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.TransportName
                </td>

                <td>
                    @item.FromCity?.Name
                </td>

                <td>
                    @item.ToCity?.Name
                </td>

                <td>
                    @item.Fare
                </td>

                <td>
                    @item.Description
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>

            </tr>
        }

    </tbody>

</table>