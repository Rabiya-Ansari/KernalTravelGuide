@model KernalTravelGuide.Models.TravelInformation

@{
    ViewData["Title"] = "Create Travel Information";
}


<h1>Create Travel Information</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TransportName"
                       class="control-label"></label>

                <input asp-for="TransportName"
                       class="form-control"
                       placeholder="e.g. Daewoo Express" />

                <span asp-validation-for="TransportName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FromCityId"
                       class="control-label">
                    From City
                </label>

                <select asp-for="FromCityId"
                        class="form-control">

                    <option value="">-- Select From City --</option>

                    @foreach (var city in ViewBag.Cities)
                    {
                        <option value="@city.Id">
                            @city.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="FromCityId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ToCityId"
                       class="control-label">
                    To City
                </label>

                <select asp-for="ToCityId"
                        class="form-control">

                    <option value="">-- Select To City --</option>

                    @foreach (var city in ViewBag.Cities)
                    {
                        <option value="@city.Id">
                            @city.Name
                        </option>
                    }

                </select>

                <span asp-validation-for="ToCityId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Fare"
                       class="control-label"></label>

                <input asp-for="Fare"
                       type="number"
                       class="form-control"
                       placeholder="Enter fare" />

                <span asp-validation-for="Fare"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"
                       class="control-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Travel information"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}